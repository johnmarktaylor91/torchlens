{
  "schema": "mikit_translation_v1",
  "comment": "TransformerLens name -> torchlens facet translation table (mikit D16). Keyed by (tlens pattern, tlens GENERATION): the 3.x bridge cache has a different vocabulary than the 2.x names ARENA teaches (measured: blocks.0.attn.hook_out and hook_attn_out are different keys in one cache). {L} is the executed-order layer index. The 4.x rows are TransformerBridge's canonical names (TransformerLens v4.2.0 docs, Model Structure); its legacy names are the 2.x rows. Optional keys: scope (attention/mlp modules only), role (token/position embedding), only_if_facet/unless_facet with absent_remedy (one name, different tensors by architecture). Consumed by the alias resolver, alias_report, the migration page, and the CI row asserting every row resolves.",
  "rows": [
    {"tlens": "hook_embed", "generation": "2.x", "facet": "lookup", "scope": "embedding", "notes": "token-embedding lookup facet; the decomposition embedding ROW is the graph-proven writer", "role": "token"},
    {"tlens": "hook_pos_embed", "generation": "2.x", "facet": "lookup", "scope": "embedding", "notes": "position-embedding lookup where the architecture has one (rotary models: absent, one embedding row)", "role": "position"},
    {"tlens": "blocks.{L}.hook_resid_pre", "generation": "2.x", "facet": "resid_pre", "scope": "block"},
    {"tlens": "blocks.{L}.hook_resid_mid", "generation": "2.x", "facet": "resid_mid", "scope": "block"},
    {"tlens": "blocks.{L}.hook_resid_post", "generation": "2.x", "facet": "resid_post", "scope": "block"},
    {"tlens": "blocks.{L}.attn.hook_q", "generation": "2.x", "facet": "q", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_k", "generation": "2.x", "facet": "k", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_v", "generation": "2.x", "facet": "v", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_attn_scores", "generation": "2.x", "facet": "scores", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_pattern", "generation": "2.x", "facet": "pattern", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_z", "generation": "2.x", "facet": "z", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_result", "generation": "2.x", "facet": "result", "scope": "attention"},
    {"tlens": "blocks.{L}.hook_attn_out", "generation": "2.x", "facet": "attn_out", "scope": "attention"},
    {"tlens": "blocks.{L}.hook_mlp_out", "generation": "2.x", "facet": "output", "scope": "mlp", "notes": "the MLP module output facet; the decomposition MLP ROW is the literal writer operand"},
    {"tlens": "ln_final.hook_scale", "generation": "2.x", "facet": "final_norm_input", "scope": "lm_head", "notes": "the frozen scale derives from final_norm_input via the validated NormReconstruction (bit-exact vs TLens hook_scale on real gpt2)"},
    {"tlens": "ln_final.hook_normalized", "generation": "2.x", "facet": "final_norm_input", "scope": "lm_head", "notes": "normalized view via NormReconstruction.apply_frozen"},
    {"tlens": "blocks.{L}.attn.hook_out", "generation": "3.x-bridge", "facet": "attn_out", "scope": "attention", "notes": "bridge-cache vocabulary; different key than 2.x hook_attn_out"},
    {"tlens": "blocks.{L}.mlp.hook_out", "generation": "3.x-bridge", "facet": "output", "scope": "mlp"},
    {"tlens": "blocks.{L}.hook_in", "generation": "3.x-bridge", "facet": "resid_pre", "scope": "block"},
    {"tlens": "blocks.{L}.hook_out", "generation": "3.x-bridge", "facet": "resid_post", "scope": "block"},
    {"tlens": "embed.hook_out", "generation": "4.x", "facet": "lookup", "scope": "embedding", "role": "token"},
    {"tlens": "pos_embed.hook_out", "generation": "4.x", "facet": "lookup", "scope": "embedding", "role": "position", "notes": "learned position table only; rotary models have no pos_embed component"},
    {"tlens": "blocks.{L}.hook_in", "generation": "4.x", "facet": "resid_pre", "scope": "block"},
    {"tlens": "blocks.{L}.ln2.hook_in", "generation": "4.x", "facet": "resid_mid", "scope": "block", "notes": "the residual sum after the attention write, not the attention branch output"},
    {"tlens": "blocks.{L}.hook_out", "generation": "4.x", "facet": "resid_post", "scope": "block"},
    {"tlens": "blocks.{L}.ln1.hook_out", "generation": "4.x", "facet": "input", "scope": "attention", "notes": "the attention sublayer's argument (4.x documents attn.hook_in as this tensor)"},
    {"tlens": "blocks.{L}.attn.hook_in", "generation": "4.x", "facet": "input", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.q.hook_in", "generation": "4.x", "facet": "input", "scope": "attention", "notes": "the projection input; equals the attention input for self-attention"},
    {"tlens": "blocks.{L}.attn.k.hook_in", "generation": "4.x", "facet": "input", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.v.hook_in", "generation": "4.x", "facet": "input", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.q.hook_out", "generation": "4.x", "facet": "q", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.k.hook_out", "generation": "4.x", "facet": "k", "scope": "attention", "notes": "KV-head count under GQA, as in 4.x"},
    {"tlens": "blocks.{L}.attn.v.hook_out", "generation": "4.x", "facet": "v", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_attn_scores", "generation": "4.x", "facet": "scores", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_pattern", "generation": "4.x", "facet": "pattern", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.o.hook_in", "generation": "4.x", "facet": "z", "scope": "attention"},
    {"tlens": "blocks.{L}.attn.hook_result", "generation": "4.x", "facet": "result", "scope": "attention", "notes": "flag-gated in 4.x (use_attn_result); a validated computed view here"},
    {"tlens": "blocks.{L}.attn.o.hook_out", "generation": "4.x", "facet": "attn_out", "scope": "attention", "notes": "the output projection; equals attn.hook_out in eval mode"},
    {"tlens": "blocks.{L}.attn.hook_out", "generation": "4.x", "facet": "attn_out", "scope": "attention"},
    {"tlens": "blocks.{L}.ln2.hook_out", "generation": "4.x", "facet": "input", "scope": "mlp", "notes": "the MLP sublayer's argument (4.x documents mlp.hook_in as this tensor)"},
    {"tlens": "blocks.{L}.mlp.hook_in", "generation": "4.x", "facet": "input", "scope": "mlp"},
    {"tlens": "blocks.{L}.mlp.hook_pre", "generation": "4.x", "facet": "up_out", "scope": "mlp", "unless_facet": "gated_out", "absent_remedy": "on gated MLPs (SwiGLU/GeGLU) 4.x binds this name to the gate projection's raw output, which no torchlens facet carries; read gated_out (post-activation) or up_out (the 4.x mlp.hook_pre_linear)"},
    {"tlens": "blocks.{L}.mlp.hook_pre_linear", "generation": "4.x", "facet": "up_out", "scope": "mlp", "only_if_facet": "gated_out", "absent_remedy": "4.x defines mlp.hook_pre_linear on gated MLPs only; on this MLP read up_out through blocks.{L}.mlp.hook_pre"},
    {"tlens": "blocks.{L}.mlp.in.hook_out", "generation": "4.x", "facet": "up_out", "scope": "mlp"},
    {"tlens": "blocks.{L}.mlp.hook_post", "generation": "4.x", "facet": "intermediate", "scope": "mlp", "notes": "the output projection's input (post-activation; gate * up on gated MLPs)"},
    {"tlens": "blocks.{L}.mlp.out.hook_in", "generation": "4.x", "facet": "intermediate", "scope": "mlp"},
    {"tlens": "blocks.{L}.mlp.out.hook_out", "generation": "4.x", "facet": "down_out", "scope": "mlp"},
    {"tlens": "blocks.{L}.mlp.hook_out", "generation": "4.x", "facet": "output", "scope": "mlp"},
    {"tlens": "ln_final.hook_in", "generation": "4.x", "facet": "final_norm_input", "scope": "lm_head"},
    {"tlens": "unembed.hook_out", "generation": "4.x", "facet": "logits", "scope": "lm_head"}
  ]
}
