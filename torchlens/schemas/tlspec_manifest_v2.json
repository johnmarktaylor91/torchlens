{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/tlspec_manifest_v2.json",
  "title": "TorchLens unified .tlspec manifest schema v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "tlspec_version",
    "kind",
    "created_at",
    "torchlens_version",
    "python_version",
    "backend",
    "backend_runtime",
    "torch_version",
    "schema_version",
    "model_signature",
    "model_fingerprint",
    "sites",
    "spec_compat_info",
    "body_format",
    "body_index",
    "backward_summary",
    "derived_gradient_summary",
    "payload_policy",
    "save_level",
    "optional_dependencies",
    "intervention_compat_metadata"
  ],
  "properties": {
    "tlspec_version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": ["intervention", "trace", "bundle"]
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "python_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "backend_runtime": {
      "type": "object"
    },
    "torch_version": {
      "type": ["string", "null"]
    },
    "model_fingerprint": {
      "type": ["object", "null"]
    },
    "body_format": {
      "type": "string",
      "enum": ["safetensors", "audit_only"]
    },
    "backward_summary": {
      "type": ["object", "null"]
    },
    "derived_gradient_summary": {
      "type": ["object", "null"]
    },
    "payload_policy": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["full", "audit_only", "metadata_only", "array_payloads"]
        }
      }
    },
    "save_level": {
      "type": "string",
      "enum": ["audit", "executable_with_callables", "portable", "runnable"]
    },
    "run": {
      "type": "object",
      "required": [
        "capability",
        "backend",
        "call_recipe",
        "callable_ref_schema",
        "state_binding",
        "input_binding",
        "control_witness",
        "initializer_policy_version",
        "payload_layers",
        "callable_registry",
        "calls",
        "tensor_slots",
        "control_witnesses",
        "witness_completeness",
        "rng_profile",
        "compatibility",
        "preflight",
        "unsupported_sites"
      ],
      "properties": {
        "capability": {"const": "sparse_recorded_taken_path_v1"},
        "call_recipe": {"const": "non_tensor_args_and_tensor_slots_v1"},
        "callable_ref_schema": {"const": 1},
        "state_binding": {"const": "module_path_role_v1"},
        "input_binding": {"const": "model_site_io_role_v1"},
        "control_witness": {"const": "scalar_bool_and_arm_entry_v1"},
        "initializer_policy_version": {"const": "torchlens_role_init_v1"},
        "payload_layers": {
          "type": "object",
          "required": ["weights", "activations"],
          "properties": {
            "weights": {
              "type": "object",
              "required": ["present", "schema"],
              "properties": {
                "present": {"type": "boolean"},
                "schema": {"const": "state_dict_v1"}
              }
            },
            "nonpersistent_buffers": {
              "type": "object",
              "required": ["present", "schema"],
              "properties": {
                "present": {"type": "boolean"},
                "schema": {"const": "runnable_nonpersistent_buffer_v1"}
              }
            },
            "activations": {
              "type": "object",
              "required": ["present", "schema"],
              "properties": {
                "present": {"type": "boolean"},
                "schema": {"const": "selected_activation_v1"},
                "members": {"type": "array"},
                "original_input_digests": {"type": "array"},
                "capture_state_digests": {"type": "array"}
              }
            }
          }
        },
        "callable_registry": {"type": "array"},
        "calls": {"type": "array"},
        "tensor_slots": {"type": "array"},
        "control_witnesses": {"type": "array"},
        "rng_profile": {
          "type": "object",
          "required": ["host_rng_consumed", "capture_seed"],
          "properties": {
            "host_rng_consumed": {"type": "boolean"},
            "capture_seed": {"type": ["integer", "null"]}
          }
        },
        "unsupported_sites": {"type": "array"}
      }
    }
  }
}
