{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/tlspec_manifest_v2.json",
  "title": "TorchLens unified .tlspec manifest schema v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "tlspec_version",
    "kind",
    "created_at",
    "torchlens_version",
    "python_version",
    "backend",
    "backend_runtime",
    "torch_version",
    "schema_version",
    "model_signature",
    "model_fingerprint",
    "sites",
    "spec_compat_info",
    "body_format",
    "body_index",
    "backward_summary",
    "derived_gradient_summary",
    "payload_policy",
    "save_level",
    "optional_dependencies",
    "intervention_compat_metadata"
  ],
  "properties": {
    "tlspec_version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": ["intervention", "trace", "bundle"]
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "python_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "backend_runtime": {
      "type": "object"
    },
    "torch_version": {
      "type": ["string", "null"]
    },
    "model_fingerprint": {
      "type": ["object", "null"]
    },
    "body_format": {
      "type": "string",
      "enum": ["safetensors", "audit_only"]
    },
    "backward_summary": {
      "type": ["object", "null"]
    },
    "derived_gradient_summary": {
      "type": ["object", "null"]
    },
    "payload_policy": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["full", "audit_only", "metadata_only", "array_payloads"]
        }
      }
    },
    "save_level": {
      "type": "string",
      "enum": ["audit", "executable_with_callables", "portable", "runnable"]
    },
    "run": {
      "type": "object",
      "required": [
        "capability",
        "backend",
        "call_recipe",
        "callable_ref_schema",
        "state_binding",
        "input_binding",
        "control_witness",
        "initializer_policy_version",
        "payload_layers",
        "callable_registry",
        "calls",
        "tensor_slots",
        "control_witnesses",
        "witness_completeness",
        "rng_profile",
        "compatibility",
        "preflight",
        "unsupported_sites"
      ],
      "properties": {
        "capability": {"const": "sparse_recorded_taken_path_v2"},
        "call_recipe": {"const": "non_tensor_args_tensor_slots_context_and_obligations_v3"},
        "callable_ref_schema": {"const": 1},
        "state_binding": {"const": "module_path_role_v1"},
        "input_binding": {"const": "model_site_io_role_v1"},
        "control_witness": {"const": "scalar_bool_and_arm_entry_v1"},
        "initializer_policy_version": {"const": "torchlens_role_init_v2"},
        "ambient_context": {
          "type": "object",
          "properties": {
            "grad_enabled": {"type": "boolean"},
            "inference_mode": {"type": "boolean"},
            "fill_uninitialized_memory": {"type": ["boolean", "null"]}
          }
        },
        "payload_layers": {
          "type": "object",
          "required": ["weights", "activations"],
          "properties": {
            "weights": {
              "type": "object",
              "required": ["present", "schema"],
              "properties": {
                "present": {"type": "boolean"},
                "schema": {"const": "state_dict_v1"}
              }
            },
            "nonpersistent_buffers": {
              "type": "object",
              "required": ["present", "schema"],
              "properties": {
                "present": {"type": "boolean"},
                "schema": {"const": "runnable_nonpersistent_buffer_v1"}
              }
            },
            "activations": {
              "type": "object",
              "required": ["present", "schema"],
              "properties": {
                "present": {"type": "boolean"},
                "schema": {"const": "selected_activation_v2"},
                "members": {"type": "array"},
                "original_input_digests": {"type": "array"},
                "capture_state_digests": {"type": "array"},
                "input_fingerprints": {"type": "array"}
              }
            }
          }
        },
        "callable_registry": {"type": "array"},
        "calls": {
          "type": "array",
          "items": {
            "properties": {
              "num_positional_args": {"minimum": 0},
              "num_keyword_args": {"minimum": 0}
            }
          }
        },
        "tensor_slots": {
          "type": "array",
          "items": {
            "properties": {
              "rank": {"minimum": 0},
              "shape": {"items": {"minimum": 0}}
            }
          }
        },
        "input_boundary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "tensor_sites"],
            "properties": {
              "position": {"type": "string"},
              "tensor_sites": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["container_path", "slot_id", "metadata_reads"],
                  "properties": {
                    "slot_id": {"type": "string"},
                    "metadata_reads": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            }
          }
        },
        "control_witnesses": {"type": "array"},
        "coverage_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gap_kind",
              "source_family",
              "source_member",
              "order",
              "resulting_completeness"
            ],
            "properties": {
              "gap_kind": {"type": "string"},
              "source_family": {"type": "string"},
              "source_member": {"type": "string"},
              "order": {"type": "integer", "minimum": 0},
              "resulting_completeness": {"type": "string"}
            }
          }
        },
        "required_witness_inventory": {
          "type": "object",
          "required": ["registry_version", "families"],
          "properties": {
            "registry_version": {"type": "string"},
            "families": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["family", "disposition", "members"],
                "properties": {
                  "family": {"type": "string"},
                  "disposition": {"type": "string"},
                  "members": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "rng_profile": {
          "type": "object",
          "required": ["host_rng_consumed", "capture_seed"],
          "properties": {
            "host_rng_consumed": {"type": "boolean"},
            "capture_seed": {"type": ["integer", "null"]}
          }
        },
        "unsupported_sites": {"type": "array"}
      }
    }
  }
}
