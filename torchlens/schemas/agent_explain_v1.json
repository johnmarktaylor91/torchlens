{
  "$id": "https://torchlens.dev/schemas/torchlens.agent.explain.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact": {
      "type": [
        "object",
        "null"
      ]
    },
    "data": {
      "additionalProperties": true,
      "properties": {
        "load_plan": {
          "type": "object"
        },
        "report": {
          "type": "string"
        }
      },
      "required": [
        "report"
      ],
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "request": {
      "type": "object"
    },
    "schema": {
      "const": "torchlens.agent.explain.v1"
    },
    "schema_stability": {
      "const": "documented-unstable"
    },
    "status": {
      "type": "string"
    },
    "torchlens_version": {
      "type": "string"
    },
    "truncation": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "data",
    "limits",
    "request",
    "schema",
    "schema_stability",
    "status",
    "torchlens_version",
    "truncation",
    "warnings"
  ],
  "title": "Plain-language report over a saved trace",
  "type": "object"
}
