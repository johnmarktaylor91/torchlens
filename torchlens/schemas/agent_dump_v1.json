{
  "$id": "https://torchlens.dev/schemas/torchlens.agent.dump.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact": {
      "type": [
        "object",
        "null"
      ]
    },
    "data": {
      "additionalProperties": true,
      "properties": {
        "class_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "load_plan": {
          "type": "object"
        },
        "next": {
          "type": [
            "object",
            "null"
          ]
        },
        "offset": {
          "type": "integer"
        },
        "rows": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "rows_total": {
          "type": "integer"
        },
        "view": {
          "enum": [
            "overview",
            "graph",
            "full"
          ]
        }
      },
      "required": [
        "view"
      ],
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "request": {
      "type": "object"
    },
    "schema": {
      "const": "torchlens.agent.dump.v1"
    },
    "schema_stability": {
      "const": "documented-unstable"
    },
    "status": {
      "type": "string"
    },
    "torchlens_version": {
      "type": "string"
    },
    "truncation": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "data",
    "limits",
    "request",
    "schema",
    "schema_stability",
    "status",
    "torchlens_version",
    "truncation",
    "warnings"
  ],
  "title": "Paged structural dump views",
  "type": "object"
}
