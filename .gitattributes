# Notebooks are committed without outputs (nbstripout, once a contributor runs
# `nbstripout --install`). The one exception is the ten-minute tutorial, which keeps
# its outputs because GitHub renders it as the first impression; regenerate them with
# `python scripts/run_notebooks.py --write-outputs`. tests/test_notebook_output_policy.py
# keeps this list equal to scripts/run_notebooks.py STORED_OUTPUT_NOTEBOOKS.
*.ipynb filter=nbstripout
*.ipynb diff=ipynb
notebooks/torchlens_in_10_minutes.ipynb -filter

# Append-only multi-writer ledgers: union merge keeps both branches' appended rows.
# Union also keeps both rows when two branches change one row or neighbouring rows,
# so every file listed here has a check in tests/test_union_merge_integrity.py that
# refuses a repeated key; that test keeps this list equal to the checked set.
# Generated artifacts (producer-parity static_scan.json, PROVENANCE), prose
# (glossary, AGENTS.md, CLAUDE.md, the docs/reference contract tables) and Python
# files (the ratchet-ceiling dicts in tests/test_file_size_ratchet.py and
# tests/test_ruff_ratchet_governance.py) are deliberately NOT union: a concurrent
# edit there must conflict (regenerate the JSON; keep both PROVENANCE entries
# whole; keep one ceiling row and set its value deliberately).
tests/composition_expectations/data/diagnostic_ratchets.tsv merge=union
tests/composition_expectations/data/refusal_site_classification.tsv merge=union
tests/composition_expectations/data/universe_cardinalities.tsv merge=union
tests/oracles/data/numeral_baseline.tsv merge=union
tests/composition_expectations/data/harvest_counts.tsv merge=union
tests/oracles/data/surface_module_classification.tsv merge=union
