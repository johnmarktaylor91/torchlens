// Computational graph for the feedforward sweep
digraph VizRecurrent {
	graph [bgcolor=white fontname=Helvetica label=<<FONT COLOR='black'><B>VizRecurrent</B><br align='left'/>8 tensors total (112 B)<br align='left'/>20 params (all trainable, 80 B)<br align='left'/></FONT>> labeljust=left labelloc=t ordering=out rankdir=BT]
	node [fontname=Helvetica ordering=out]
	edge [fontname=Helvetica]
	input_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>input_1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR><TR><TD ALIGN="CENTER">@input.x</TD></TR></TABLE>> color=black fillcolor="#98FB98" fontcolor=black ordering=out shape=oval style="filled,solid"]
	input_1 -> linear_1_1 [arrowsize=.7 color=black fontcolor=black headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="8">In 1</FONT></TD></TR></TABLE>> labelfontsize=8 style=solid]
	linear_1_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>linear_1_1 (x3)</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR><TR><TD ALIGN="CENTER">in_features=4</TD></TR><TR><TD ALIGN="CENTER">params: weight (4, 4) · bias (4,)</TD></TR><TR><TD ALIGN="CENTER">@cell</TD></TR></TABLE>> color=black fillcolor="#D9D9D9" fontcolor=black ordering=out shape=box style="filled,solid"]
	linear_1_1 -> tanh_1_2 [arrowsize=.7 color=black fontcolor=black headlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="8">In 1-3</FONT></TD></TR></TABLE>> labelfontsize=8 style=solid taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="8">Out 1-3</FONT></TD></TR></TABLE>>]
	tanh_1_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>tanh_1_2 (x3)</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR></TABLE>> color=black fillcolor=white fontcolor=black ordering=out shape=oval style="filled,solid"]
	tanh_1_2 -> linear_1_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="8"></TD><TD><FONT POINT-SIZE="8">In 2-3<BR/>Out 1-2</FONT></TD><TD WIDTH="8"></TD></TR></TABLE>> arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	tanh_1_2 -> output_1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid taillabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="8">Out 3</FONT></TD></TR></TABLE>>]
	output_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>output_1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR><TR><TD ALIGN="CENTER">@output</TD></TR></TABLE>> color=black fillcolor="#ff9999" fontcolor=black ordering=out shape=oval style="filled,solid"]
	{
		rank=sink
		output_1
	}
}
