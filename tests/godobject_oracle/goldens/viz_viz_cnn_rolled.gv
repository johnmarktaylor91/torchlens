// Computational graph for the feedforward sweep
digraph VizCNN {
	graph [bgcolor=white fontname=Helvetica label=<<FONT COLOR='black'><B>VizCNN</B><br align='left'/>6 tensors total (340 B)<br align='left'/>29 params (all trainable, 116 B)<br align='left'/></FONT>> labeljust=left labelloc=t ordering=out rankdir=BT]
	node [fontname=Helvetica ordering=out]
	edge [fontname=Helvetica]
	input_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>input_1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 1, 4, 4), 64 B</TD></TR><TR><TD ALIGN="CENTER">@input.x</TD></TR></TABLE>> color=black fillcolor="#98FB98" fontcolor=black ordering=out shape=oval style="filled,solid"]
	input_1 -> conv2d_1_1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	conv2d_1_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>conv2d_1_1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 2, 4, 4), 128 B</TD></TR><TR><TD ALIGN="CENTER">kernel_size=(3, 3), padding=(1, 1)</TD></TR><TR><TD ALIGN="CENTER">params: weight (2, 1, 3, 3) · bias (2,)</TD></TR><TR><TD ALIGN="CENTER">@conv</TD></TR></TABLE>> color=black fillcolor="#D9D9D9" fontcolor=black ordering=out shape=box style="filled,solid"]
	conv2d_1_1 -> relu_1_2 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	relu_1_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>relu_1_2</B></TD></TR><TR><TD ALIGN="CENTER">(1, 2, 4, 4), 128 B</TD></TR></TABLE>> color=black fillcolor=white fontcolor=black ordering=out shape=oval style="filled,solid"]
	relu_1_2 -> mean_1_3 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	mean_1_3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>mean_1_3</B></TD></TR><TR><TD ALIGN="CENTER">(1, 2), 8 B</TD></TR><TR><TD ALIGN="CENTER">dim=(2, 3)</TD></TR></TABLE>> color=black fillcolor=white fontcolor=black ordering=out shape=oval style="filled,solid"]
	mean_1_3 -> linear_1_4 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	linear_1_4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>linear_1_4</B></TD></TR><TR><TD ALIGN="CENTER">(1, 3), 12 B</TD></TR><TR><TD ALIGN="CENTER">params: weight (3, 2) · bias (3,)</TD></TR><TR><TD ALIGN="CENTER">@head</TD></TR></TABLE>> color=black fillcolor="#D9D9D9" fontcolor=black ordering=out shape=box style="filled,solid"]
	linear_1_4 -> output_1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	output_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>output_1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 3), 12 B</TD></TR><TR><TD ALIGN="CENTER">@output</TD></TR></TABLE>> color=black fillcolor="#ff9999" fontcolor=black ordering=out shape=oval style="filled,solid"]
	{
		rank=sink
		output_1
	}
}
