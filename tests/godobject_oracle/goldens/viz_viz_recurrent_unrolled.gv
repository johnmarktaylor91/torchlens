// Computational graph for the feedforward sweep
digraph VizRecurrent {
	graph [bgcolor=white label=<<FONT COLOR='black'><B>VizRecurrent</B><br align='left'/>8 tensors total (112 B)<br align='left'/>20 params (all trainable, 80 B)<br align='left'/></FONT>> labeljust=left labelloc=t ordering=out rankdir=BT]
	node [ordering=out]
	input_1pass1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>input_1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR><TR><TD ALIGN="CENTER">@input.x</TD></TR></TABLE>> color=black fillcolor="#98FB98" fontcolor=black ordering=out shape=oval style="filled,solid"]
	input_1pass1 -> linear_1_1pass1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	linear_1_1pass1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>linear_1_1:1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR><TR><TD ALIGN="CENTER">params: weight (4, 4) · bias (4,)</TD></TR><TR><TD ALIGN="CENTER">@cell:1</TD></TR></TABLE>> color=black fillcolor="#D9D9D9" fontcolor=black ordering=out shape=box style="filled,solid"]
	linear_1_1pass1 -> tanh_1_2pass1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	tanh_1_2pass1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>tanh_1_2:1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR></TABLE>> color=black fillcolor=white fontcolor=black ordering=out shape=oval style="filled,solid"]
	tanh_1_2pass1 -> linear_1_1pass2 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	linear_1_1pass2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>linear_1_1:2</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR><TR><TD ALIGN="CENTER">params: weight (4, 4) · bias (4,)</TD></TR><TR><TD ALIGN="CENTER">@cell:2</TD></TR></TABLE>> color=black fillcolor="#D9D9D9" fontcolor=black ordering=out shape=box style="filled,solid"]
	linear_1_1pass2 -> tanh_1_2pass2 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	tanh_1_2pass2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>tanh_1_2:2</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR></TABLE>> color=black fillcolor=white fontcolor=black ordering=out shape=oval style="filled,solid"]
	tanh_1_2pass2 -> linear_1_1pass3 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	linear_1_1pass3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>linear_1_1:3</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR><TR><TD ALIGN="CENTER">params: weight (4, 4) · bias (4,)</TD></TR><TR><TD ALIGN="CENTER">@cell:3</TD></TR></TABLE>> color=black fillcolor="#D9D9D9" fontcolor=black ordering=out shape=box style="filled,solid"]
	linear_1_1pass3 -> tanh_1_2pass3 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	tanh_1_2pass3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>tanh_1_2:3</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR></TABLE>> color=black fillcolor=white fontcolor=black ordering=out shape=oval style="filled,solid"]
	tanh_1_2pass3 -> output_1pass1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	output_1pass1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>output_1</B></TD></TR><TR><TD ALIGN="CENTER">(1, 4), 16 B</TD></TR><TR><TD ALIGN="CENTER">@output</TD></TR></TABLE>> color=black fillcolor="#ff9999" fontcolor=black ordering=out shape=oval style="filled,solid"]
	{
		rank=sink
		output_1pass1
	}
}
