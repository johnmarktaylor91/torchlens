# import-linter contracts for torchlens: the layer separations that hold today.
#
# Layers come from torchlens/_architecture.py (L0 lowest .. L9 highest). Each
# layered package gets up to two "forbidden" contracts against the higher-layer
# packages it does not import:
#   <pkg>-no-path    no import chain at all, direct or indirect;
#   <pkg>-no-direct  no direct import (allow_indirect_imports), for higher
#                    packages reached today only through other packages.
# In-function (deferred) imports count; TYPE_CHECKING imports do not.
# Layer pairs that already import upward directly are the layering backlog and
# have no contract yet. Contracts are only added or tightened (a no-direct
# target moves to no-path), never removed or loosened.
#
# Run: lint-imports --config .importlinter (or python scripts/checks/run_all.py).

[importlinter]
root_package = torchlens
exclude_type_checking_imports = true

[importlinter:contract:_autoroute-no-path]
name = _autoroute (L4) does not import higher layers
type = forbidden
source_modules =
    torchlens._autoroute
forbidden_modules =
    torchlens.callbacks
    torchlens.checks
    torchlens.examples
    torchlens.export
    torchlens.neuro
    torchlens.repgeom
    torchlens.trackers

[importlinter:contract:_autoroute-no-direct]
name = _autoroute (L4) does not import higher layers directly
type = forbidden
source_modules =
    torchlens._autoroute
forbidden_modules =
    torchlens._extraction
    torchlens._notebook
    torchlens._observability
    torchlens.attribution
    torchlens.debug
    torchlens.receptive_field
    torchlens.report
    torchlens.semantic
    torchlens.stats
    torchlens.visualization
    torchlens.viz
allow_indirect_imports = true

