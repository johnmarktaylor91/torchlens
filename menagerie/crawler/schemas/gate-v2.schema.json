{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/menagerie/crawler/gate-v2.schema.json",
  "title": "Menagerie crawler immutable checker gate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "ledger_seq",
    "payload_sha256",
    "gate_kind",
    "batch_size",
    "gate_round",
    "gate_identity",
    "checker",
    "items",
    "result_envelope_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "menagerie.crawler.gate.v2",
      "description": "Mandatory versioned schema identifier."
    },
    "gate_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory immutable gate identifier."
    },
    "ledger_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Mandatory monotonic ledger sequence."
    },
    "payload_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory hash of the complete ledger payload."
    },
    "gate_kind": {
      "enum": [
        "metadata_batch",
        "fidelity"
      ],
      "description": "Mandatory checker gate kind."
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Mandatory number of items in this gate."
    },
    "gate_round": {
      "type": "integer",
      "minimum": 1,
      "description": "Mandatory checker repair round."
    },
    "gate_identity": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory hash binding the gate inputs and checker."
    },
    "checker": {
      "$ref": "#/$defs/checker",
      "description": "Mandatory checker identity and timing."
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "description": "Mandatory gate verdict items."
    },
    "result_envelope_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory result envelope sha256."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_kind": {
            "const": "metadata_batch",
            "description": "Mandatory checker gate kind."
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Mandatory number of items in this gate."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/item"
                },
                {
                  "properties": {
                    "fidelity": {
                      "properties": {
                        "required": {
                          "const": false,
                          "description": "Best-effort required."
                        },
                        "verdict": {
                          "const": "not-applicable",
                          "description": "Mandatory checker verdict."
                        }
                      },
                      "description": "Mandatory implementation-fidelity gate state."
                    }
                  }
                }
              ]
            },
            "description": "Mandatory gate verdict items."
          }
        }
      },
      "else": {
        "properties": {
          "batch_size": {
            "const": 1,
            "description": "Mandatory number of items in this gate."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/item"
            },
            "description": "Mandatory gate verdict items."
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_hash": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accuracy_verdict": {
      "enum": [
        "accurate",
        "inaccurate",
        "cannot-verify"
      ]
    },
    "rung": {
      "enum": [
        "R1_LIBRARY",
        "R2_VENDOR",
        "R3_PORT",
        "R4_REIMPLEMENT",
        "R5_SKIP"
      ]
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "version",
        "prompt_sha256",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "provider": {
          "const": "openai",
          "description": "Best-effort provider associated with the event."
        },
        "model": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory model."
        },
        "version": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory version."
        },
        "prompt_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory prompt sha256."
        },
        "started_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Mandatory UTC start timestamp."
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Mandatory UTC completion timestamp."
        }
      }
    },
    "verified_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "source_manifest",
        "evidence",
        "code",
        "source_to_code_map",
        "family_template"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory proposal."
        },
        "source_manifest": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory source manifest."
        },
        "evidence": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory literal evidence and coverage record."
        },
        "code": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory closed status code."
        },
        "code_manifest": {
          "$ref": "#/$defs/hash",
          "description": "Closed recursive model-code path-and-byte manifest digest."
        },
        "source_to_code_map": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory source to code map."
        },
        "family_template": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory family template."
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "hash_mismatches",
        "excerpt_discrepancies",
        "locator_failures"
      ],
      "properties": {
        "verdict": {
          "$ref": "#/$defs/accuracy_verdict",
          "description": "Mandatory checker verdict."
        },
        "hash_mismatches": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory hash mismatches."
        },
        "excerpt_discrepancies": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory excerpt discrepancies."
        },
        "locator_failures": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory locator failures."
        }
      }
    },
    "field_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "verdict",
        "evidence_ids",
        "checked_source_ids",
        "reason",
        "required_repair"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory field."
        },
        "verdict": {
          "$ref": "#/$defs/accuracy_verdict",
          "description": "Mandatory checker verdict."
        },
        "evidence_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory supporting evidence identifiers."
        },
        "checked_source_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory checked source ids."
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory reason."
        },
        "required_repair": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory required repair."
        }
      }
    },
    "material_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "verdict",
        "source_id",
        "source_locator",
        "evidence_ids",
        "code_path",
        "code_locator",
        "reason"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory category."
        },
        "verdict": {
          "enum": [
            "match",
            "minor-drift",
            "major-drift",
            "slop",
            "cannot-verify"
          ],
          "description": "Mandatory checker verdict."
        },
        "source_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory source identifier."
        },
        "source_locator": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory source locator."
        },
        "evidence_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory supporting evidence identifiers."
        },
        "code_path": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory code path."
        },
        "code_locator": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory code locator."
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory reason."
        }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "verdict",
        "material_checks",
        "unsupported_choices",
        "contradictions",
        "omissions",
        "permanent_scar"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Mandatory required."
        },
        "verdict": {
          "enum": [
            "match",
            "minor-drift",
            "major-drift",
            "slop",
            "cannot-verify",
            "not-applicable"
          ],
          "description": "Mandatory checker verdict."
        },
        "material_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material_check"
          },
          "description": "Mandatory material fidelity findings."
        },
        "unsupported_choices": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory unsupported choices."
        },
        "contradictions": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory contradictions."
        },
        "omissions": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory omissions."
        },
        "permanent_scar": {
          "type": "boolean",
          "description": "Mandatory permanent scar."
        }
      }
    },
    "rung_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_rung",
        "highest_applicable",
        "verdict",
        "findings"
      ],
      "properties": {
        "selected_rung": {
          "$ref": "#/$defs/rung",
          "description": "Mandatory selected rung."
        },
        "highest_applicable": {
          "$ref": "#/$defs/rung",
          "description": "Mandatory highest applicable."
        },
        "verdict": {
          "$ref": "#/$defs/accuracy_verdict",
          "description": "Mandatory checker verdict."
        },
        "findings": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory findings."
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "campaign_root_work_id",
        "stable_id",
        "family_representative_id",
        "fidelity_identity",
        "vet_identity",
        "verified_hashes",
        "integrity",
        "verdict",
        "field_checks",
        "fidelity",
        "rung_check",
        "unsupported_claims",
        "required_repairs",
        "confidence"
      ],
      "properties": {
        "work_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory deterministic work identifier."
        },
        "campaign_root_work_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Stable campaign/root-work lineage across repaired proposals."
        },
        "stable_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory stable model identifier."
        },
        "family_representative_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory family representative id."
        },
        "fidelity_identity": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory fidelity identity."
        },
        "vet_identity": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory vet identity."
        },
        "verified_hashes": {
          "$ref": "#/$defs/verified_hashes",
          "description": "Mandatory verified hashes."
        },
        "integrity": {
          "$ref": "#/$defs/integrity",
          "description": "Mandatory integrity."
        },
        "verdict": {
          "$ref": "#/$defs/accuracy_verdict",
          "description": "Mandatory checker verdict."
        },
        "field_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_check"
          },
          "description": "Mandatory per-field accuracy findings."
        },
        "fidelity": {
          "$ref": "#/$defs/fidelity",
          "description": "Mandatory implementation-fidelity gate state."
        },
        "rung_check": {
          "$ref": "#/$defs/rung_check",
          "description": "Mandatory rung check."
        },
        "unsupported_claims": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory unsupported claims."
        },
        "required_repairs": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory repairs required before acceptance."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Mandatory checker confidence level."
        }
      }
    }
  }
}
