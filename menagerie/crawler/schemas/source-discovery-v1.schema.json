{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/menagerie/crawler/source-discovery-v1.schema.json",
  "title": "Menagerie crawler typed source discovery v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stable_id", "work_id", "arm", "payload"],
  "properties": {
    "schema_version": {
      "const": "menagerie.crawler.source-discovery.v1",
      "description": "Machine-defined source-discovery contract discriminator."
    },
    "stable_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Exact trusted model identity copied from the source request."
    },
    "work_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Exact active work identity copied from the source request."
    },
    "arm": {
      "enum": [
        "FOUND",
        "NO_USABLE_SOURCE",
        "INSUFFICIENT_DESCRIPTION",
        "NOT_A_MODEL",
        "NEEDS_HIGHER_TIER",
        "RETRYABLE_TOOL_FAILURE"
      ],
      "description": "Closed model-judged discovery outcome."
    },
    "payload": {
      "oneOf": [
        {"$ref": "#/$defs/found"},
        {"$ref": "#/$defs/no_usable_source"},
        {"$ref": "#/$defs/insufficient_description"},
        {"$ref": "#/$defs/not_a_model"},
        {"$ref": "#/$defs/needs_higher_tier"},
        {"$ref": "#/$defs/retryable_tool_failure"}
      ],
      "description": "Strict arm-specific discovery payload."
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "requested_role": {
      "enum": ["implementation", "paper", "documentation", "probe"]
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "observed_web_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Observed HTTP(S) research locator; unlike a fetch descriptor, it grants no dereference authority."
    },
    "forge_file_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "repo",
        "path",
        "ref",
        "requested_role",
        "basis"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id",
          "description": "Model-local correlation label with no external identity authority."
        },
        "kind": {
          "const": "forge-file",
          "description": "Request to resolve and fetch one forge-hosted file."
        },
        "repo": {
          "type": "string",
          "pattern": "^(?:https://)?(?:www\\.)?github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?/?$",
          "description": "GitHub repository locator to resolve through the forge API."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$",
          "description": "Normalized repository-relative file path."
        },
        "ref": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Requested tag, branch, version, or commit-ish to dereference."
        },
        "requested_role": {
          "$ref": "#/$defs/requested_role",
          "description": "Model judgment about intended use; never an authoritative broker role."
        },
        "media_type_hint": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Optional authored hint that never controls the manifest media type."
        },
        "basis": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Grounded explanation of why the requested object is relevant."
        },
        "notes": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Optional source-specific observations about material architecture, configuration, or inference details found at this locator."
        }
      }
    },
    "raw_url_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "url", "requested_role", "basis"],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id",
          "description": "Model-local correlation label with no external identity authority."
        },
        "kind": {
          "const": "raw-url",
          "description": "Request to fetch one direct HTTPS object."
        },
        "url": {
          "$ref": "#/$defs/https_url",
          "description": "Requested HTTPS locator subject to bounded dereference."
        },
        "requested_role": {
          "$ref": "#/$defs/requested_role",
          "description": "Model judgment about intended use; never an authoritative broker role."
        },
        "media_type_hint": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Optional authored hint that never controls the manifest media type."
        },
        "basis": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Grounded explanation of why the requested object is relevant."
        },
        "notes": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Optional source-specific observations about material architecture, configuration, or inference details found at this locator."
        }
      }
    },
    "paper_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "requested_role", "basis"],
      "oneOf": [
        {"required": ["url"]},
        {"required": ["identifier"]}
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id",
          "description": "Model-local correlation label with no external identity authority."
        },
        "kind": {
          "const": "paper",
          "description": "Request to resolve paper metadata through an authoritative registry."
        },
        "url": {
          "$ref": "#/$defs/https_url",
          "description": "Requested paper locator carrying a supported registry identifier."
        },
        "identifier": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Requested arXiv, DOI, or OpenReview identifier."
        },
        "requested_role": {
          "$ref": "#/$defs/requested_role",
          "description": "Model judgment about intended use; never an authoritative broker role."
        },
        "media_type_hint": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Optional authored hint that never controls a manifest media type."
        },
        "basis": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Grounded explanation of why the requested paper is relevant."
        },
        "notes": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Optional source-specific observations about material architecture, configuration, or inference details found at this locator."
        }
      }
    },
    "source_descriptor": {
      "oneOf": [
        {"$ref": "#/$defs/forge_file_descriptor"},
        {"$ref": "#/$defs/raw_url_descriptor"},
        {"$ref": "#/$defs/paper_descriptor"}
      ]
    },
    "rejection_class": {
      "enum": [
        "not-this-model",
        "no-material-detail",
        "access-barrier",
        "dead-link",
        "not-a-nn"
      ],
      "description": "Closed author reading of why one observed locator was not usable. Required and closed on purpose: with only free prose, 'we could not read it' was indistinguishable from 'there was nothing to read', so a paywall silently became an absence claim. Every candidate is now classified, which makes an access barrier an assertion the record carries rather than a silence it hides. 'not-this-model' is a homonym or a different architecture; 'no-material-detail' is about this model but never specifies the forward pass; 'access-barrier' is readable in principle but was withheld (paywall, login wall, subscription, institutional access); 'dead-link' does not resolve at all; 'not-a-nn' establishes the named thing is not a neural network."
    },
    "candidate_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "why_rejected", "rejection_class"],
      "properties": {
        "url": {
          "$ref": "#/$defs/observed_web_url",
          "description": "Observed research locator retained as evidence, not a fetch request."
        },
        "why_rejected": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Model-authored reason the candidate does not satisfy the source need."
        },
        "rejection_class": {
          "$ref": "#/$defs/rejection_class",
          "description": "Author's closed reading of why it stopped at this locator. Falsifiable against the machine's own probe of the same locator; a disagreement between the two is a checker signal and is never reconciled silently."
        }
      }
    },
    "search_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries",
        "places",
        "candidate_links",
        "languages",
        "conclusion"
      ],
      "properties": {
        "queries": {
          "$ref": "#/$defs/nonempty_string_array",
          "description": "Exact bounded search queries attempted."
        },
        "places": {
          "$ref": "#/$defs/nonempty_string_array",
          "description": "Exact indexes, hosts, registries, or archives searched."
        },
        "candidate_links": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidate_link"
          },
          "description": "Candidate locators paired with authored rejection reasons."
        },
        "languages": {
          "$ref": "#/$defs/nonempty_string_array",
          "description": "Languages covered by the bounded search."
        },
        "conclusion": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Bounded model judgment supported by the preceding search record."
        }
      }
    },
    "found": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "sources"],
      "properties": {
        "arm": {
          "const": "FOUND",
          "description": "FOUND payload discriminator."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_descriptor"
          },
          "description": "Strict broker requests containing locators but no derived identities."
        }
      }
    },
    "no_usable_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "search_evidence"],
      "properties": {
        "arm": {
          "const": "NO_USABLE_SOURCE",
          "description": "NO_USABLE_SOURCE payload discriminator."
        },
        "search_evidence": {
          "$ref": "#/$defs/search_evidence",
          "description": "Bounded search evidence supporting the no-source judgment."
        }
      }
    },
    "insufficient_description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "search_evidence", "retained_vague_text"],
      "properties": {
        "arm": {
          "const": "INSUFFICIENT_DESCRIPTION",
          "description": "INSUFFICIENT_DESCRIPTION payload discriminator."
        },
        "search_evidence": {
          "$ref": "#/$defs/search_evidence",
          "description": "Bounded search evidence supporting the insufficiency judgment."
        },
        "retained_vague_text": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Exact retained text that is too vague to specify the forward pass."
        }
      }
    },
    "not_a_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "search_evidence"],
      "properties": {
        "arm": {
          "const": "NOT_A_MODEL",
          "description": "NOT_A_MODEL payload discriminator."
        },
        "search_evidence": {
          "$ref": "#/$defs/search_evidence",
          "description": "Bounded search evidence supporting the non-model judgment."
        }
      }
    },
    "needs_higher_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "research_summary"],
      "properties": {
        "arm": {
          "const": "NEEDS_HIGHER_TIER",
          "description": "NEEDS_HIGHER_TIER payload discriminator."
        },
        "research_summary": {
          "$ref": "#/$defs/search_evidence",
          "description": "Bounded research record carried to the higher-tier campaign."
        }
      }
    },
    "retryable_tool_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "tool_name", "tool_spelling", "error"],
      "properties": {
        "arm": {
          "const": "RETRYABLE_TOOL_FAILURE",
          "description": "RETRYABLE_TOOL_FAILURE payload discriminator."
        },
        "tool_name": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Human-readable research tool name."
        },
        "tool_spelling": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Exact registered tool spelling used by the session."
        },
        "error": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Verbatim tool error observed by the session."
        }
      }
    }
  },
  "x-authority-ownership": {
    "$.arm": "author-gated",
    "$.payload.arm": "author-gated",
    "$.payload.error": "author-gated",
    "$.payload.research_summary.candidate_links[].rejection_class": "author-gated",
    "$.payload.research_summary.candidate_links[].url": "author-gated",
    "$.payload.research_summary.candidate_links[].why_rejected": "author-gated",
    "$.payload.research_summary.conclusion": "author-gated",
    "$.payload.research_summary.languages[]": "author-gated",
    "$.payload.research_summary.places[]": "author-gated",
    "$.payload.research_summary.queries[]": "author-gated",
    "$.payload.retained_vague_text": "author-gated",
    "$.payload.search_evidence.candidate_links[].rejection_class": "author-gated",
    "$.payload.search_evidence.candidate_links[].url": "author-gated",
    "$.payload.search_evidence.candidate_links[].why_rejected": "author-gated",
    "$.payload.search_evidence.conclusion": "author-gated",
    "$.payload.search_evidence.languages[]": "author-gated",
    "$.payload.search_evidence.places[]": "author-gated",
    "$.payload.search_evidence.queries[]": "author-gated",
    "$.payload.sources[].basis": "author-gated",
    "$.payload.sources[].identifier": "author-gated",
    "$.payload.sources[].kind": "author-gated",
    "$.payload.sources[].media_type_hint": "author-gated",
    "$.payload.sources[].notes": "author-gated",
    "$.payload.sources[].path": "author-gated",
    "$.payload.sources[].ref": "author-gated",
    "$.payload.sources[].repo": "author-gated",
    "$.payload.sources[].requested_role": "author-gated",
    "$.payload.sources[].source_id": "author-gated",
    "$.payload.sources[].url": "author-gated",
    "$.payload.tool_name": "author-gated",
    "$.payload.tool_spelling": "author-gated",
    "$.schema_version": "reducer-derived",
    "$.stable_id": "trusted-intake",
    "$.work_id": "reducer-derived"
  }
}
