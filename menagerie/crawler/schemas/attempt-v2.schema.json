{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/menagerie/crawler/attempt-v2.schema.json",
  "title": "Menagerie crawler immutable attempt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "ledger_seq",
    "payload_sha256",
    "work_id",
    "stable_id",
    "attempt_no",
    "parent_attempt_id",
    "actor",
    "stage",
    "mode",
    "started_at",
    "finished_at",
    "result",
    "attempted_rungs",
    "retries",
    "identities",
    "environment",
    "host",
    "invocation",
    "worker_receipt",
    "supervisor_observation",
    "policy_observation",
    "error",
    "defer_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "menagerie.crawler.attempt.v2",
      "description": "Mandatory versioned schema identifier."
    },
    "attempt_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory immutable attempt identifier."
    },
    "ledger_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Mandatory monotonic ledger sequence."
    },
    "payload_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory hash of the complete ledger payload."
    },
    "work_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory deterministic work identifier."
    },
    "stable_id": {
      "$ref": "#/$defs/nullable_string",
      "description": "Mandatory stable model identifier."
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1,
      "description": "Mandatory ordinal attempt number."
    },
    "parent_attempt_id": {
      "$ref": "#/$defs/nullable_string",
      "description": "Best-effort parent attempt identifier."
    },
    "actor": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory producing actor."
    },
    "stage": {
      "$ref": "#/$defs/stage",
      "description": "Mandatory processing or failure stage."
    },
    "mode": {
      "oneOf": [
        {
          "enum": [
            "train",
            "eval"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Mandatory mode."
    },
    "started_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Mandatory UTC start timestamp."
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Mandatory UTC completion timestamp."
    },
    "result": {
      "enum": [
        "succeeded",
        "failed",
        "observed"
      ],
      "description": "Mandatory immutable attempt outcome."
    },
    "attempted_rungs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rung"
      },
      "uniqueItems": true,
      "description": "Mandatory attempted rungs."
    },
    "retries": {
      "$ref": "#/$defs/retries",
      "description": "Mandatory retries."
    },
    "identities": {
      "$ref": "#/$defs/identities",
      "description": "Mandatory identities."
    },
    "environment": {
      "$ref": "#/$defs/environment",
      "description": "Mandatory environment."
    },
    "host": {
      "$ref": "#/$defs/host",
      "description": "Mandatory host."
    },
    "invocation": {
      "$ref": "#/$defs/invocation",
      "description": "Mandatory invocation."
    },
    "worker_receipt": {
      "$ref": "#/$defs/worker_receipt",
      "description": "Mandatory worker receipt."
    },
    "supervisor_observation": {
      "$ref": "#/$defs/supervisor_observation",
      "description": "Mandatory supervisor observation."
    },
    "policy_observation": {
      "$ref": "#/$defs/policy_observation",
      "description": "Mandatory policy observation."
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ],
      "description": "Mandatory error."
    },
    "defer_evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/defer_evidence"
        },
        {
          "type": "null"
        }
      ],
      "description": "Mandatory defer evidence."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "forward",
            "description": "Mandatory processing or failure stage."
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "enum": [
              "train",
              "eval"
            ],
            "description": "Best-effort mode."
          },
          "invocation": {
            "properties": {
              "mode": {
                "enum": [
                  "train",
                  "eval"
                ],
                "description": "Best-effort mode."
              }
            },
            "description": "Best-effort invocation."
          },
          "worker_receipt": {
            "properties": {
              "mode": {
                "enum": [
                  "train",
                  "eval"
                ],
                "description": "Best-effort mode."
              }
            },
            "description": "Best-effort worker receipt."
          }
        }
      },
      "else": {
        "properties": {
          "mode": {
            "type": "null",
            "description": "Best-effort mode."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "failed",
            "description": "Mandatory immutable attempt outcome."
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error",
            "description": "Best-effort error."
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_hash": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "enum": [
        "intake",
        "source",
        "fetch",
        "evidence",
        "accuracy-gate",
        "environment",
        "import",
        "constructor",
        "input",
        "forward",
        "fidelity",
        "resource",
        "policy",
        "runner"
      ]
    },
    "reason_code": {
      "enum": [
        "schema-invalid",
        "stable-id-conflict",
        "duplicate-revision-conflict",
        "migration-invariant",
        "identity-unresolved",
        "missing-mandatory-link",
        "source-model-mismatch",
        "higher-rung-unresolved",
        "unreachable",
        "revision-missing",
        "hash-mismatch",
        "access-denied",
        "artifact-missing",
        "locator-missing",
        "excerpt-mismatch",
        "insufficient-detail",
        "coverage-incomplete",
        "search-incomplete",
        "inaccurate-cap-exhausted",
        "cannot-verify-cap-exhausted",
        "identity-mismatch",
        "checker-contract-invalid",
        "solve-failed",
        "lock-missing",
        "artifact-hash-mismatch",
        "build-failed",
        "probe-failed",
        "resolved-export-mismatch",
        "island-cap",
        "below-minimum-island-size",
        "module-missing",
        "symbol-missing",
        "abi-load-failed",
        "import-exception",
        "exception",
        "requires-checkpoint",
        "requires-weight-asset",
        "invalid-model-object",
        "contract-invalid",
        "source-invalid-shape",
        "generation-exception",
        "semantic-constraint",
        "mode-run",
        "incomplete-receipt",
        "invalid-output-signature",
        "confirmation-mismatch",
        "major-drift-cap-exhausted",
        "slop-cap-exhausted",
        "timeout",
        "oom",
        "disk-floor",
        "scratch-cap",
        "rss-cap",
        "network-attempt",
        "checkpoint-read",
        "write-outside-scratch",
        "credentials-exposed",
        "torchlens-import",
        "opaque-code",
        "native-crash",
        "signal",
        "missing-receipt",
        "protocol-violation",
        "ledger-corruption",
        "internal-error",
        "sandbox-unavailable-v1",
        "effort-cap-exhausted"
      ]
    },
    "rung": {
      "enum": [
        "R1_LIBRARY",
        "R2_VENDOR",
        "R3_PORT",
        "R4_REIMPLEMENT",
        "R5_SKIP"
      ]
    },
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_attempt",
        "root_cause_repeat",
        "author_round",
        "gate_round"
      ],
      "properties": {
        "stage_attempt": {
          "type": "integer",
          "minimum": 0,
          "description": "Mandatory stage attempt."
        },
        "root_cause_repeat": {
          "type": "integer",
          "minimum": 0,
          "description": "Mandatory root cause repeat."
        },
        "author_round": {
          "type": "integer",
          "minimum": 0,
          "description": "Mandatory author round."
        },
        "gate_round": {
          "type": "integer",
          "minimum": 0,
          "description": "Mandatory checker repair round."
        }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "evidence",
        "recipe",
        "environment",
        "execution",
        "runner",
        "author_prompt",
        "checker_prompt"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory source."
        },
        "evidence": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory literal evidence and coverage record."
        },
        "recipe": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory recipe."
        },
        "environment": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory environment."
        },
        "execution": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory execution identity and currentness state."
        },
        "runner": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory runner."
        },
        "author_prompt": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory author prompt."
        },
        "checker_prompt": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory checker prompt."
        }
      }
    },
    "environment": {
      "oneOf": [
        {
          "$ref": "#/$defs/observed_environment"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "target",
        "env_id",
        "lock_sha256",
        "resolved_export_sha256",
        "python",
        "packages_manifest_sha256",
        "compiler_identity",
        "sdk_identity"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory family."
        },
        "target": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory target."
        },
        "env_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory env id."
        },
        "lock_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory lock sha256."
        },
        "resolved_export_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory resolved export sha256."
        },
        "python": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory python."
        },
        "packages_manifest_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory packages manifest sha256."
        },
        "compiler_identity": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory compiler identity."
        },
        "sdk_identity": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory sdk identity."
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_id",
        "os",
        "os_build",
        "architecture",
        "cpu",
        "ram_bytes",
        "accelerator",
        "accelerator_runtime"
      ],
      "properties": {
        "machine_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory machine id."
        },
        "os": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory os."
        },
        "os_build": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory os build."
        },
        "architecture": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory architecture."
        },
        "cpu": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory cpu."
        },
        "ram_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Mandatory ram bytes."
        },
        "accelerator": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory accelerator."
        },
        "accelerator_runtime": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory accelerator runtime."
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "safe_env",
        "seed",
        "device",
        "mode",
        "network_policy",
        "timeout_seconds",
        "rss_limit_bytes",
        "scratch_limit_bytes"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Mandatory argv."
        },
        "cwd": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory cwd."
        },
        "safe_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mandatory safe env."
        },
        "seed": {
          "type": "integer",
          "description": "Mandatory seed."
        },
        "device": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory device."
        },
        "mode": {
          "oneOf": [
            {
              "enum": [
                "train",
                "eval"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory mode."
        },
        "network_policy": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory network policy."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800,
          "description": "Mandatory timeout seconds."
        },
        "rss_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Mandatory rss limit bytes."
        },
        "scratch_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Mandatory scratch limit bytes."
        }
      }
    },
    "input_kind": {
      "type": "string",
      "pattern": "^(standard-[a-z0-9-]+|random-fallback)$"
    },
    "worker_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "receipt_sha256",
        "observed_recipe_revision",
        "observed_adapter_sha256",
        "observed_code_manifest_sha256",
        "observed_input_asset_sha256",
        "constructor_started",
        "constructor_completed",
        "input_completed",
        "forward_started",
        "forward_completed",
        "mode",
        "input_signature",
        "output_signature",
        "input_kind",
        "input_asset",
        "input_note",
        "parameter_count_total",
        "parameter_count_trainable",
        "native_framework",
        "delegated_method"
      ],
      "properties": {
        "present": {
          "type": "boolean",
          "description": "Mandatory present."
        },
        "receipt_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory receipt sha256."
        },
        "observed_recipe_revision": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Worker-observed recipe revision, required for parent comparison."
        },
        "observed_adapter_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Worker-observed typed-adapter digest, or null for declarative recipes."
        },
        "observed_code_manifest_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Worker-observed digest over the recursive code_manifest bytes, or null when the recipe has no code manifest."
        },
        "observed_input_asset_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Worker-observed digest of the materialized standard input asset, or null when no standard asset was selected."
        },
        "constructor_started": {
          "type": "boolean",
          "description": "Mandatory constructor started."
        },
        "constructor_completed": {
          "type": "boolean",
          "description": "Mandatory constructor completed."
        },
        "input_completed": {
          "type": "boolean",
          "description": "Mandatory input completed."
        },
        "forward_started": {
          "type": "boolean",
          "description": "Mandatory forward started."
        },
        "forward_completed": {
          "type": "boolean",
          "description": "Mandatory forward completed."
        },
        "mode": {
          "oneOf": [
            {
              "enum": [
                "train",
                "eval"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory mode."
        },
        "input_signature": {
          "description": "Mandatory input signature."
        },
        "output_signature": {
          "description": "Mandatory output signature."
        },
        "input_kind": {
          "oneOf": [
            {
              "$ref": "#/$defs/input_kind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory input kind."
        },
        "input_asset": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory input asset."
        },
        "input_note": {
          "type": "string",
          "description": "Mandatory input note."
        },
        "parameter_count_total": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory parameter count total."
        },
        "parameter_count_trainable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory parameter count trainable."
        },
        "native_framework": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory native framework."
        },
        "delegated_method": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory delegated method."
        }
      }
    },
    "supervisor_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "signal",
        "wall_seconds",
        "cpu_seconds",
        "peak_rss_bytes",
        "stdout_sha256",
        "stdout_bytes",
        "stdout_tail",
        "stderr_sha256",
        "stderr_bytes",
        "stderr_tail",
        "full_log_local_path",
        "full_log_retention"
      ],
      "properties": {
        "exit_code": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory exit code."
        },
        "signal": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory signal."
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Mandatory wall seconds."
        },
        "cpu_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Mandatory cpu seconds."
        },
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Mandatory peak rss bytes."
        },
        "stdout_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory stdout sha256."
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Mandatory stdout bytes."
        },
        "stdout_tail": {
          "type": "string",
          "maxLength": 1500,
          "description": "Mandatory stdout tail."
        },
        "stderr_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory stderr sha256."
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Mandatory stderr bytes."
        },
        "stderr_tail": {
          "type": "string",
          "maxLength": 1500,
          "description": "Mandatory stderr tail."
        },
        "full_log_local_path": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory full log local path."
        },
        "full_log_retention": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory full log retention."
        }
      }
    },
    "policy_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_attempted",
        "socket_targets",
        "checkpoint_or_weight_read_attempted",
        "checkpoint_paths",
        "write_outside_scratch_attempted",
        "write_paths",
        "credentials_present",
        "torchlens_import_attempted",
        "cache_read_attempted"
      ],
      "properties": {
        "network_attempted": {
          "type": "boolean",
          "description": "Mandatory network attempted."
        },
        "socket_targets": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory socket targets."
        },
        "checkpoint_or_weight_read_attempted": {
          "type": "boolean",
          "description": "Mandatory checkpoint or weight read attempted."
        },
        "checkpoint_paths": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory checkpoint paths."
        },
        "write_outside_scratch_attempted": {
          "type": "boolean",
          "description": "Mandatory write outside scratch attempted."
        },
        "write_paths": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory write paths."
        },
        "credentials_present": {
          "type": "boolean",
          "description": "Mandatory credentials present."
        },
        "torchlens_import_attempted": {
          "type": "boolean",
          "description": "Mandatory torchlens import attempted."
        },
        "cache_read_attempted": {
          "type": "boolean",
          "description": "Mandatory cache read attempted."
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "reason_code",
        "exception_type",
        "message",
        "traceback",
        "no_traceback_reason",
        "native_crash",
        "root_cause_fingerprint",
        "details"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage",
          "description": "Mandatory processing or failure stage."
        },
        "reason_code": {
          "$ref": "#/$defs/reason_code",
          "description": "Mandatory closed reason code when applicable."
        },
        "exception_type": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory exception type."
        },
        "message": {
          "type": "string",
          "description": "Mandatory message."
        },
        "traceback": {
          "$ref": "#/$defs/nullable_string",
          "description": "Best-effort captured traceback."
        },
        "no_traceback_reason": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory no traceback reason."
        },
        "native_crash": {
          "type": "boolean",
          "description": "Mandatory native crash."
        },
        "root_cause_fingerprint": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory root cause fingerprint."
        },
        "details": {
          "type": "object",
          "description": "Mandatory structured event details."
        }
      },
      "oneOf": [
        {
          "properties": {
            "traceback": {
              "type": "string",
              "minLength": 1,
              "description": "Best-effort captured traceback."
            },
            "no_traceback_reason": {
              "type": "null",
              "description": "Best-effort no traceback reason."
            }
          }
        },
        {
          "properties": {
            "traceback": {
              "type": "null",
              "description": "Best-effort captured traceback."
            },
            "no_traceback_reason": {
              "type": "string",
              "minLength": 1,
              "description": "Best-effort no traceback reason."
            }
          }
        }
      ]
    },
    "defer_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_status",
        "source_ids",
        "probe_attempt_ids",
        "explanation"
      ],
      "properties": {
        "target_status": {
          "enum": [
            "deferred:needs-cuda",
            "deferred:needs-x86"
          ],
          "description": "Mandatory target status."
        },
        "source_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory source ids."
        },
        "probe_attempt_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory probe attempt ids."
        },
        "explanation": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory explanation."
        }
      }
    }
  }
}
