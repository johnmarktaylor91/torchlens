{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-v3.schema.json",
  "title": "Menagerie crawler staged author proposal v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_sha256",
    "work_id",
    "stable_id",
    "created_at",
    "author",
    "source_identity",
    "evidence_identity",
    "recipe_revision",
    "fidelity_identity",
    "vet_identity",
    "verified_hashes",
    "proposed_facts",
    "campaign_id",
    "intake_snapshot_id",
    "intake_snapshot_sha256",
    "intake_item_sha256",
    "source_manifest_identity",
    "dispatcher_identity"
  ],
  "properties": {
    "schema_version": {
      "const": "menagerie.crawler.author-proposal.v3",
      "description": "Mandatory current author-proposal discriminator; v2 proposals are legacy-untrusted."
    },
    "proposal_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory immutable author-proposal identifier."
    },
    "proposal_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory hash of the complete proposal."
    },
    "work_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory deterministic work identifier."
    },
    "stable_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory stable model identifier."
    },
    "created_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Mandatory UTC creation timestamp."
    },
    "author": {
      "$ref": "#/$defs/author",
      "description": "Mandatory author model identity."
    },
    "source_identity": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory source identity."
    },
    "evidence_identity": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory evidence identity."
    },
    "recipe_revision": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory recipe revision."
    },
    "fidelity_identity": {
      "$ref": "#/$defs/nullable_hash",
      "description": "Mandatory fidelity identity."
    },
    "vet_identity": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory vet identity."
    },
    "verified_hashes": {
      "$ref": "#/$defs/verified_hashes",
      "description": "Mandatory verified hashes."
    },
    "proposed_facts": {
      "$ref": "#/$defs/proposed_facts",
      "description": "Mandatory proposed source-read facts."
    },
    "campaign_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Exact author campaign identity."
    },
    "intake_snapshot_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Exact active trusted intake snapshot identity."
    },
    "intake_snapshot_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Digest of the exact active trusted intake snapshot."
    },
    "intake_item_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Digest of the full verified intake row for this stable identity."
    },
    "source_manifest_identity": {
      "$ref": "#/$defs/hash",
      "description": "Exact frozen source-manifest identity used by the author."
    },
    "dispatcher_identity": {
      "$ref": "#/$defs/hash",
      "description": "Versioned author dispatcher closure identity."
    }
  },
  "$defs": {
    "hash": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/hash"
    },
    "nullable_hash": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/nullable_hash"
    },
    "timestamp": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/timestamp"
    },
    "nonempty_string": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/nonempty_string"
    },
    "nullable_string": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/nullable_string"
    },
    "string_array": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/string_array"
    },
    "author": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/author"
    },
    "verified_hashes": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/verified_hashes"
    },
    "identity": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/identity"
    },
    "taxonomy": {
      "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-common.schema.json#/$defs/taxonomy"
    },
    "external_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modality",
        "architecture_class",
        "domain",
        "task",
        "field",
        "subfield",
        "paradigm",
        "lineage",
        "predecessors",
        "tags",
        "keywords",
        "venue",
        "family",
        "era",
        "year",
        "country",
        "authors",
        "institution",
        "citation",
        "license",
        "key_contribution",
        "description",
        "original_framework",
        "run_framework",
        "modes"
      ],
      "properties": {
        "modality": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory modality."
        },
        "architecture_class": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory architecture class."
        },
        "domain": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory domain."
        },
        "task": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory task."
        },
        "field": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory field."
        },
        "subfield": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory subfield."
        },
        "paradigm": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory paradigm."
        },
        "lineage": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory lineage."
        },
        "predecessors": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory predecessors."
        },
        "tags": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory tags."
        },
        "keywords": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory non-empty English user search terms. These are relevance-checked model/family/task/domain aliases and phrases, not verbatim-source quotations."
        },
        "venue": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory venue."
        },
        "family": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory family."
        },
        "era": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory era; null only with a declared availability state."
        },
        "year": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory year."
        },
        "country": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory country."
        },
        "authors": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory authors."
        },
        "institution": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory institution."
        },
        "citation": {
          "$ref": "model-v3.schema.json#/$defs/citation",
          "description": "Best-effort gated citation metadata."
        },
        "license": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory license."
        },
        "key_contribution": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory key contribution."
        },
        "description": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory description."
        },
        "original_framework": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory original framework."
        },
        "run_framework": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory run framework."
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "meaningful_modes",
            "train_eval_divergence"
          ],
          "properties": {
            "meaningful_modes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "train",
                  "eval"
                ]
              },
              "uniqueItems": true,
              "description": "Mandatory meaningful modes."
            },
            "train_eval_divergence": {
              "enum": [
                "none",
                "statistical",
                "structural"
              ],
              "description": "Mandatory train eval divergence."
            }
          },
          "description": "Mandatory meaningful runtime-mode record."
        },
        "availability": {
          "$ref": "#/$defs/availability_claims",
          "description": "Optional typed availability states for judgment facts that can be honestly unknown."
        }
      }
    },
    "proposed_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "taxonomy",
        "external_metadata",
        "website",
        "people_and_origin",
        "dates",
        "citation",
        "licenses",
        "source_resolution",
        "evidence",
        "implementation",
        "input_contract",
        "modes",
        "fidelity"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity",
          "description": "Mandatory canonical model identity."
        },
        "taxonomy": {
          "$ref": "#/$defs/taxonomy",
          "description": "Best-effort gated architecture taxonomy."
        },
        "external_metadata": {
          "$ref": "#/$defs/external_metadata",
          "description": "Best-effort gated externally sourced catalog metadata."
        },
        "website": {
          "$ref": "model-v3.schema.json#/$defs/website",
          "description": "Best-effort presentation metadata for the catalog page."
        },
        "people_and_origin": {
          "$ref": "model-v3.schema.json#/$defs/people_and_origin",
          "description": "Best-effort gated people and origin metadata."
        },
        "dates": {
          "$ref": "model-v3.schema.json#/$defs/dates",
          "description": "Best-effort gated publication-date metadata."
        },
        "citation": {
          "$ref": "model-v3.schema.json#/$defs/citation",
          "description": "Best-effort gated citation metadata."
        },
        "licenses": {
          "$ref": "model-v3.schema.json#/$defs/licenses",
          "description": "Best-effort gated source-license metadata."
        },
        "source_resolution": {
          "allOf": [
            {
              "$ref": "model-v3.schema.json#/$defs/source_resolution"
            },
            {
              "properties": {
                "rung": {
                  "$ref": "model-common.schema.json#/$defs/rung",
                  "description": "Mandatory selected source-resolution ladder rung. NO_RUNG_SELECTED is a driver-observed outcome and is never author-selectable."
                }
              }
            }
          ],
          "description": "Mandatory selected source rung and search record. An author proposal must name a real ladder rung: the NO_RUNG_SELECTED sentinel is a driver-observed outcome and is structurally inexpressible here."
        },
        "evidence": {
          "$ref": "model-v3.schema.json#/$defs/evidence",
          "description": "Mandatory literal evidence and coverage record."
        },
        "implementation": {
          "$ref": "model-v3.schema.json#/$defs/implementation",
          "description": "Mandatory executable implementation recipe."
        },
        "input_contract": {
          "$ref": "model-v3.schema.json#/$defs/input_contract",
          "description": "Mandatory source-valid dummy-input contract."
        },
        "modes": {
          "$ref": "model-v3.schema.json#/$defs/modes",
          "description": "Mandatory meaningful runtime-mode record."
        },
        "fidelity": {
          "$ref": "model-v3.schema.json#/$defs/fidelity",
          "description": "Mandatory implementation-fidelity gate state."
        }
      }
    },
    "availability_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "values",
        "basis",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "present",
            "not-found-after-search",
            "not-applicable",
            "none-exist"
          ],
          "description": "Mandatory closed availability disposition. none-exist asserts the fact genuinely does not exist for this model (no predecessors, no lineage, no novel operator); not-found-after-search asserts it could not be established. Both require the recorded bounded search."
        },
        "values": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/nonempty_string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "description": "Mandatory values; non-empty exactly when status is present."
        },
        "basis": {
          "enum": [
            "machine-derived",
            "stated-in-paper",
            "stated-in-code",
            "stated-on-website",
            "derived-from-affiliation",
            "judged",
            "search-exhausted",
            "not-applicable"
          ],
          "description": "Mandatory closed availability basis, declaring where the disposition came from. An absence reached by reading the frozen sources and finding nothing is search-exhausted -- that is the basis for every not-found-after-search and none-exist state, however the looking was actually done. Descriptive prose is refused: this enum is the whole vocabulary."
        },
        "evidence": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory evidence-ID list backing the disposition."
        }
      },
      "description": "One typed availability state for a judgment fact."
    },
    "availability_claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authors": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for authors."
        },
        "country": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for country."
        },
        "era": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for era."
        },
        "field": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for field."
        },
        "institution": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for institution."
        },
        "license": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for license."
        },
        "subfield": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for subfield."
        },
        "venue": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for venue."
        },
        "year": {
          "$ref": "#/$defs/availability_claim",
          "description": "Optional typed availability state for year."
        },
        "lineage": {
          "$ref": "#/$defs/availability_claim",
          "description": "Typed availability state for external_metadata.lineage. Required when lineage is empty: none-exist when the model genuinely has no recorded lineage, not-found-after-search when it could not be established."
        },
        "predecessors": {
          "$ref": "#/$defs/availability_claim",
          "description": "Typed availability state for external_metadata.predecessors. Required when predecessors is empty."
        },
        "taxonomy.novel_ops": {
          "$ref": "#/$defs/availability_claim",
          "description": "Typed availability state for the taxonomy.novel_ops claim, keyed by its full canonical claim path because it is owned by another block. Required when novel_ops is empty."
        }
      },
      "description": "Optional per-claim typed availability states; bare null or empty never passes the gate. External-metadata claims are keyed by bare field name; claims owned by another block are keyed by their full canonical claim path."
    },
    "gated_claim_category": {
      "enum": [
        "external_metadata.architecture_class",
        "external_metadata.authors",
        "external_metadata.citation",
        "external_metadata.country",
        "external_metadata.description",
        "external_metadata.domain",
        "external_metadata.era",
        "external_metadata.family",
        "external_metadata.field",
        "external_metadata.institution",
        "external_metadata.key_contribution",
        "external_metadata.license",
        "external_metadata.lineage",
        "external_metadata.modality",
        "external_metadata.modes",
        "external_metadata.original_framework",
        "external_metadata.paradigm",
        "external_metadata.predecessors",
        "external_metadata.run_framework",
        "external_metadata.subfield",
        "external_metadata.tags",
        "external_metadata.task",
        "external_metadata.venue",
        "external_metadata.year",
        "input_contract",
        "source_resolution.rung",
        "taxonomy.architecture_tags",
        "taxonomy.domains",
        "taxonomy.era",
        "taxonomy.family",
        "taxonomy.modalities",
        "taxonomy.novel_ops",
        "taxonomy.tasks",
        "website"
      ],
      "description": "The closed gated-claim vocabulary the coverage gate enforces, published here so it is machine-discoverable rather than existing only in Python. Coverage matches an excerpt's supports entry against these strings by EXACT equality: a leaf path such as external_metadata.citation.arxiv_id does not satisfy external_metadata.citation, and a cross-block spelling such as implementation.original_framework does not satisfy external_metadata.original_framework. This enum is deliberately NOT applied as a constraint on supports items, because a proposal may legitimately tag additional finer-grained strings; it is the required vocabulary, not the permitted one. Kept in step with menagerie.crawler.proposal.DEFAULT_GATED_CLAIMS by test_claim_vocabulary_is_derived_from_code."
    }
  },
