{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-v3.schema.json",
  "title": "Menagerie crawler staged author proposal v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_sha256",
    "work_id",
    "stable_id",
    "created_at",
    "author",
    "source_identity",
    "evidence_identity",
    "recipe_revision",
    "fidelity_identity",
    "vet_identity",
    "verified_hashes",
    "proposed_facts",
    "campaign_id",
    "intake_snapshot_id",
    "intake_snapshot_sha256",
    "intake_item_sha256",
    "source_manifest_identity",
    "dispatcher_identity"
  ],
  "properties": {
    "schema_version": {
      "const": "menagerie.crawler.author-proposal.v3",
      "description": "Mandatory current author-proposal discriminator; v2 proposals are legacy-untrusted."
    },
    "proposal_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory immutable author-proposal identifier."
    },
    "proposal_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory hash of the complete proposal."
    },
    "work_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory deterministic work identifier."
    },
    "stable_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory stable model identifier."
    },
    "created_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Mandatory UTC creation timestamp."
    },
    "author": {
      "$ref": "#/$defs/author",
      "description": "Mandatory author model identity."
    },
    "source_identity": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory source identity."
    },
    "evidence_identity": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory evidence identity."
    },
    "recipe_revision": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory recipe revision."
    },
    "fidelity_identity": {
      "$ref": "#/$defs/nullable_hash",
      "description": "Mandatory fidelity identity."
    },
    "vet_identity": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory vet identity."
    },
    "verified_hashes": {
      "$ref": "#/$defs/verified_hashes",
      "description": "Mandatory verified hashes."
    },
    "proposed_facts": {
      "$ref": "#/$defs/proposed_facts",
      "description": "Mandatory proposed source-read facts."
    },
    "campaign_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Exact author campaign identity."
    },
    "intake_snapshot_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Exact active trusted intake snapshot identity."
    },
    "intake_snapshot_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Digest of the exact active trusted intake snapshot."
    },
    "intake_item_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Digest of the full verified intake row for this stable identity."
    },
    "source_manifest_identity": {
      "$ref": "#/$defs/hash",
      "description": "Exact frozen source-manifest identity used by the author."
    },
    "dispatcher_identity": {
      "$ref": "#/$defs/hash",
      "description": "Versioned author dispatcher closure identity."
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_hash": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "version",
        "prompt_sha256"
      ],
      "properties": {
        "provider": {
          "const": "anthropic",
          "description": "Best-effort provider associated with the event."
        },
        "model": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory model."
        },
        "version": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory version."
        },
        "prompt_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory prompt sha256."
        }
      }
    },
    "verified_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest",
        "evidence",
        "code",
        "source_to_code_map",
        "family_template"
      ],
      "properties": {
        "source_manifest": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory source manifest."
        },
        "evidence": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory literal evidence and coverage record."
        },
        "code": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory closed status code."
        },
        "code_manifest": {
          "$ref": "#/$defs/hash",
          "description": "Closed recursive model-code path-and-byte manifest digest."
        },
        "source_to_code_map": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory source to code map."
        },
        "family_template": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory family template."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "$ref": "#/$defs/hash",
                "description": "Typed implementation entry-point digest."
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "code_manifest"
            ]
          },
          "else": {
            "not": {
              "required": [
                "code_manifest"
              ]
            }
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_name",
        "aliases",
        "acronym",
        "variant",
        "variant_scope",
        "family_representative_id",
        "duplicate_of",
        "alias_of"
      ],
      "properties": {
        "canonical_name": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory canonical name."
        },
        "aliases": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory aliases."
        },
        "acronym": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory acronym."
        },
        "variant": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory variant."
        },
        "variant_scope": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory variant scope."
        },
        "family_representative_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory family representative id."
        },
        "duplicate_of": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory duplicate of."
        },
        "alias_of": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory alias of."
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "domains",
        "tasks",
        "modalities",
        "era",
        "architecture_tags",
        "novel_ops"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory family."
        },
        "domains": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory domains."
        },
        "tasks": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory tasks."
        },
        "modalities": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory modalities."
        },
        "era": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory era."
        },
        "architecture_tags": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory architecture tags."
        },
        "novel_ops": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory novel ops."
        }
      }
    },
    "external_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modality",
        "architecture_class",
        "domain",
        "task",
        "field",
        "subfield",
        "paradigm",
        "lineage",
        "predecessors",
        "tags",
        "keywords",
        "venue",
        "family",
        "era",
        "year",
        "country",
        "authors",
        "institution",
        "citation",
        "license",
        "key_contribution",
        "description",
        "original_framework",
        "run_framework",
        "modes"
      ],
      "properties": {
        "modality": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory modality."
        },
        "architecture_class": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory architecture class."
        },
        "domain": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory domain."
        },
        "task": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory task."
        },
        "field": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory field."
        },
        "subfield": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory subfield."
        },
        "paradigm": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory paradigm."
        },
        "lineage": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory lineage."
        },
        "predecessors": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory predecessors."
        },
        "tags": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory tags."
        },
        "keywords": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory non-empty English user search terms. These are relevance-checked model/family/task/domain aliases and phrases, not verbatim-source quotations."
        },
        "venue": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory venue."
        },
        "family": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory family."
        },
        "era": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory era."
        },
        "year": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory year."
        },
        "country": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory country."
        },
        "authors": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory authors."
        },
        "institution": {
          "$ref": "#/$defs/string_array",
          "description": "Mandatory institution."
        },
        "citation": {
          "$ref": "model-v3.schema.json#/$defs/citation",
          "description": "Best-effort gated citation metadata."
        },
        "license": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory license."
        },
        "key_contribution": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory key contribution."
        },
        "description": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory description."
        },
        "original_framework": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory original framework."
        },
        "run_framework": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory run framework."
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "meaningful_modes",
            "train_eval_divergence"
          ],
          "properties": {
            "meaningful_modes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "train",
                  "eval"
                ]
              },
              "uniqueItems": true,
              "description": "Mandatory meaningful modes."
            },
            "train_eval_divergence": {
              "enum": [
                "none",
                "statistical",
                "structural"
              ],
              "description": "Mandatory train eval divergence."
            }
          },
          "description": "Mandatory meaningful runtime-mode record."
        }
      }
    },
    "proposed_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "taxonomy",
        "external_metadata",
        "website",
        "people_and_origin",
        "dates",
        "citation",
        "licenses",
        "source_resolution",
        "evidence",
        "implementation",
        "input_contract",
        "modes",
        "fidelity"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity",
          "description": "Mandatory canonical model identity."
        },
        "taxonomy": {
          "$ref": "#/$defs/taxonomy",
          "description": "Best-effort gated architecture taxonomy."
        },
        "external_metadata": {
          "$ref": "#/$defs/external_metadata",
          "description": "Best-effort gated externally sourced catalog metadata."
        },
        "website": {
          "$ref": "model-v3.schema.json#/$defs/website",
          "description": "Best-effort presentation metadata for the catalog page."
        },
        "people_and_origin": {
          "$ref": "model-v3.schema.json#/$defs/people_and_origin",
          "description": "Best-effort gated people and origin metadata."
        },
        "dates": {
          "$ref": "model-v3.schema.json#/$defs/dates",
          "description": "Best-effort gated publication-date metadata."
        },
        "citation": {
          "$ref": "model-v3.schema.json#/$defs/citation",
          "description": "Best-effort gated citation metadata."
        },
        "licenses": {
          "$ref": "model-v3.schema.json#/$defs/licenses",
          "description": "Best-effort gated source-license metadata."
        },
        "source_resolution": {
          "$ref": "model-v3.schema.json#/$defs/source_resolution",
          "description": "Mandatory selected source rung and search record."
        },
        "evidence": {
          "$ref": "model-v3.schema.json#/$defs/evidence",
          "description": "Mandatory literal evidence and coverage record."
        },
        "implementation": {
          "$ref": "model-v3.schema.json#/$defs/implementation",
          "description": "Mandatory executable implementation recipe."
        },
        "input_contract": {
          "$ref": "model-v3.schema.json#/$defs/input_contract",
          "description": "Mandatory source-valid dummy-input contract."
        },
        "modes": {
          "$ref": "model-v3.schema.json#/$defs/modes",
          "description": "Mandatory meaningful runtime-mode record."
        },
        "fidelity": {
          "$ref": "model-v3.schema.json#/$defs/fidelity",
          "description": "Mandatory implementation-fidelity gate state."
        }
      }
    }
  },
