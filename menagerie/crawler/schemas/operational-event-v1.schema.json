{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/menagerie/crawler/operational-event-v1.schema.json",
  "title": "Menagerie crawler operational event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "ledger_seq",
    "payload_sha256",
    "created_at",
    "event_kind",
    "status",
    "provider",
    "observed_response",
    "reset_at",
    "queued_work_counts",
    "current_environment",
    "run_id",
    "machine_id",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": "menagerie.crawler.operational-event.v1",
      "description": "Mandatory versioned schema identifier."
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Mandatory immutable operational-event identifier."
    },
    "ledger_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Mandatory monotonic ledger sequence."
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Mandatory hash of the complete ledger payload."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Mandatory UTC creation timestamp."
    },
    "event_kind": {
      "enum": [
        "usage-pause",
        "usage-resume",
        "wakeup",
        "checkpoint",
        "campaign-health",
        "wake-noop-already-running"
      ],
      "description": "Mandatory operational event kind."
    },
    "status": {
      "enum": [
        "paused:usage-limit",
        "resumed:usage-limit",
        "wakeup-scheduled",
        "wakeup-fired",
        "wake-noop-already-running",
        "checkpoint-complete",
        "checkpoint-failed",
        "healthy",
        "failed:runner"
      ],
      "description": "Mandatory closed current disposition."
    },
    "provider": {
      "oneOf": [
        {
          "enum": [
            "anthropic",
            "openai"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Best-effort provider associated with the event."
    },
    "observed_response": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Best-effort observed provider response."
    },
    "reset_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Best-effort scheduled provider reset time."
    },
    "queued_work_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Mandatory queued work counts."
    },
    "current_environment": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Mandatory current environment."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Mandatory run id."
    },
    "machine_id": {
      "type": "string",
      "minLength": 1,
      "description": "Mandatory machine id."
    },
    "details": {
      "type": "object",
      "description": "Mandatory structured event details."
    }
  }
}
