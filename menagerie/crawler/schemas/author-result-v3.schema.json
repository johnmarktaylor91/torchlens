  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty_string"
      },
      "uniqueItems": true
    },
    "proposed_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "proposal"
      ],
      "properties": {
        "arm": {
          "const": "PROPOSED",
          "description": "Proposed-result arm discriminator."
        },
        "proposal": {
          "$ref": "https://torchlens.org/schemas/menagerie/crawler/author-proposal-v3.schema.json",
          "description": "Complete frozen author proposal v3."
        }
      }
    },
    "defer_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "platform",
        "source_ids",
        "evidence_ids",
        "evidence_identity",
        "license_identity",
        "recommendation_sha256"
      ],
      "properties": {
        "arm": {
          "const": "DEFER_RECOMMENDATION",
          "description": "Platform-deferral recommendation arm discriminator."
        },
        "platform": {
          "enum": [
            "cuda",
            "x86"
          ],
          "description": "Closed recommended platform capability."
        },
        "source_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Hash-bound candidate source identities."
        },
        "evidence_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Hash-bound candidate evidence excerpts."
        },
        "evidence_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact candidate evidence-pack identity."
        },
        "license_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact proposed license disposition identity."
        },
        "recommendation_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the closed recommendation payload."
        }
      }
    },
    "skip_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "status_code",
        "source_ids",
        "evidence_ids",
        "evidence_identity",
        "search_report_identity",
        "license_identity",
        "recommendation_sha256"
      ],
      "properties": {
        "arm": {
          "const": "SKIP_RECOMMENDATION",
          "description": "Epistemic skip recommendation arm discriminator."
        },
        "status_code": {
          "enum": [
            "skipped:insufficient-description",
            "skipped:no-description",
            "skipped:not-a-real-NN"
          ],
          "description": "Closed R5 status recommendation."
        },
        "source_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Hash-bound candidate source identities."
        },
        "evidence_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Hash-bound candidate evidence excerpts."
        },
        "evidence_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact candidate evidence-pack identity."
        },
        "search_report_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact bounded search-report identity."
        },
        "license_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact proposed license disposition identity."
        },
        "recommendation_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the closed recommendation payload."
        }
      }
    },
    "blocked_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "stage",
        "reason_code",
        "prerequisite_ids",
        "evidence_ids",
        "evidence_identity",
        "license_identity",
        "recommendation_sha256"
      ],
      "properties": {
        "arm": {
          "const": "BLOCKED",
          "description": "Blocked-prerequisite recommendation arm discriminator."
        },
        "stage": {
          "enum": [
            "source",
            "fetch",
            "evidence",
            "environment",
            "policy",
            "runner"
          ],
          "description": "Closed recommended blocking stage."
        },
        "reason_code": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Typed recommended root reason code."
        },
        "prerequisite_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Exact prerequisite fact identities claimed missing or failed."
        },
        "evidence_ids": {
          "$ref": "#/$defs/string_array",
          "description": "Hash-bound candidate evidence excerpts."
        },
        "evidence_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact candidate evidence-pack identity."
        },
        "license_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact proposed license disposition identity."
        },
        "recommendation_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the closed recommendation payload."
        }
      }
    }
  }
}
