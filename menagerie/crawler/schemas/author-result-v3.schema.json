{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/menagerie/crawler/author-result-v3.schema.json",
  "title": "Menagerie crawler typed author result v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "result_sha256",
    "kind",
    "stable_id",
    "work_id",
    "campaign_id",
    "created_at",
    "author_identity",
    "prompt_identity",
    "dispatcher_identity",
    "source_manifest_identity",
    "intake_snapshot_id",
    "intake_snapshot_sha256",
    "intake_item_sha256",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "menagerie.crawler.author-result.v3",
      "description": "Mandatory typed author-result discriminator."
    },
    "result_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Immutable typed author-result identity."
    },
    "result_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Digest of the exact typed author-result bytes."
    },
    "kind": {
      "enum": [
        "PROPOSED",
        "DEFER_RECOMMENDATION",
        "SKIP_RECOMMENDATION",
        "BLOCKED"
      ],
      "description": "Closed advisory author-result arm."
    },
    "stable_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Trusted stable model identity."
    },
    "work_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Deterministic work identity."
    },
    "campaign_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Exact author campaign identity."
    },
    "created_at": {
      "$ref": "#/$defs/timestamp",
      "description": "UTC result creation timestamp."
    },
    "author_identity": {
      "$ref": "#/$defs/hash",
      "description": "Exact author provider, model, and version identity."
    },
    "prompt_identity": {
      "$ref": "#/$defs/hash",
      "description": "Exact frozen author prompt identity."
    },
    "dispatcher_identity": {
      "$ref": "#/$defs/hash",
      "description": "Versioned author dispatcher closure identity."
    },
    "source_manifest_identity": {
      "$ref": "#/$defs/hash",
      "description": "Exact frozen source-manifest identity."
    },
    "intake_snapshot_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Exact active trusted intake snapshot identity."
    },
    "intake_snapshot_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Digest of the active intake snapshot."
    },
    "intake_item_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Digest of the full verified intake row."
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/proposed_payload"
        },
        {
          "$ref": "#/$defs/defer_payload"
        },
        {
          "$ref": "#/$defs/skip_payload"
        },
        {
          "$ref": "#/$defs/blocked_payload"
        }
      ],
      "description": "Arm-specific closed advisory payload."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PROPOSED",
            "description": "Select the proposed arm."
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/proposed_payload",
            "description": "Closed proposed payload."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "DEFER_RECOMMENDATION",
            "description": "Select the defer arm."
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/defer_payload",
            "description": "Closed defer payload."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SKIP_RECOMMENDATION",
            "description": "Select the skip arm."
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/skip_payload",
            "description": "Closed skip payload."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "BLOCKED",
            "description": "Select the blocked arm."
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/blocked_payload",
            "description": "Closed blocked payload."
          }
        }
      }
    }
  ],
