{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torchlens.org/schemas/menagerie/crawler/attempt-v3.schema.json",
  "title": "Menagerie crawler immutable attempt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "ledger_seq",
    "payload_sha256",
    "work_id",
    "stable_id",
    "attempt_no",
    "parent_attempt_id",
    "actor",
    "stage",
    "mode",
    "started_at",
    "finished_at",
    "result",
    "attempted_rungs",
    "retries",
    "identities",
    "environment",
    "host",
    "invocation",
    "worker_receipt",
    "supervisor_observation",
    "policy_observation",
    "error",
    "defer_evidence",
    "capability_observation",
    "execution_read_manifest_identity",
    "raw_award_receipt",
    "raw_award_receipt_sha256",
    "parent_attestation",
    "unattested_partial"
  ],
  "properties": {
    "schema_version": {
      "const": "menagerie.crawler.attempt.v3",
      "description": "Mandatory current attempt contract discriminator; immutable v2 rows are legacy-untrusted history."
    },
    "attempt_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory immutable attempt identifier."
    },
    "ledger_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Mandatory monotonic ledger sequence."
    },
    "payload_sha256": {
      "$ref": "#/$defs/hash",
      "description": "Mandatory hash of the complete ledger payload."
    },
    "work_id": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory deterministic work identifier."
    },
    "stable_id": {
      "$ref": "#/$defs/nullable_string",
      "description": "Mandatory stable model identifier."
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1,
      "description": "Mandatory ordinal attempt number."
    },
    "parent_attempt_id": {
      "$ref": "#/$defs/nullable_string",
      "description": "Best-effort parent attempt identifier."
    },
    "actor": {
      "$ref": "#/$defs/nonempty_string",
      "description": "Mandatory producing actor."
    },
    "stage": {
      "$ref": "#/$defs/stage",
      "description": "Mandatory processing or failure stage."
    },
    "mode": {
      "oneOf": [
        {
          "enum": [
            "train",
            "eval"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Mandatory mode."
    },
    "started_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Mandatory UTC start timestamp."
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Mandatory UTC completion timestamp."
    },
    "result": {
      "enum": [
        "succeeded",
        "failed",
        "observed"
      ],
      "description": "Mandatory immutable attempt outcome."
    },
    "attempted_rungs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rung"
      },
      "uniqueItems": true,
      "description": "Mandatory attempted rungs."
    },
    "retries": {
      "$ref": "#/$defs/retries",
      "description": "Mandatory retries."
    },
    "identities": {
      "$ref": "#/$defs/identities",
      "description": "Mandatory identities."
    },
    "environment": {
      "$ref": "#/$defs/environment",
      "description": "Mandatory environment."
    },
    "host": {
      "$ref": "#/$defs/host",
      "description": "Mandatory host."
    },
    "invocation": {
      "$ref": "#/$defs/invocation",
      "description": "Mandatory invocation."
    },
    "worker_receipt": {
      "$ref": "#/$defs/worker_receipt",
      "description": "Mandatory worker receipt."
    },
    "supervisor_observation": {
      "$ref": "#/$defs/supervisor_observation",
      "description": "Mandatory supervisor observation."
    },
    "policy_observation": {
      "$ref": "#/$defs/policy_observation",
      "description": "Mandatory policy observation."
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ],
      "description": "Mandatory error."
    },
    "defer_evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/defer_evidence"
        },
        {
          "type": "null"
        }
      ],
      "description": "Mandatory defer evidence."
    },
    "capability_observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/capability_observation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional parent-observed focused platform capability result."
    },
    "execution_read_manifest_identity": {
      "$ref": "#/$defs/hash",
      "description": "Reducer-bound identity of the trusted compiled execution read manifest."
    },
    "raw_award_receipt": {
      "oneOf": [
        {
          "$ref": "#/$defs/raw_award_receipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Closed success-only worker receipt retained as canonical raw proof bytes."
    },
    "raw_award_receipt_sha256": {
      "$ref": "#/$defs/nullable_hash",
      "description": "Worker self-hash of the exact canonical raw award receipt bytes."
    },
    "parent_attestation": {
      "$ref": "#/$defs/parent_attestation",
      "description": "Separately named parent attestation over completion and process facts."
    },
    "unattested_partial": {
      "oneOf": [
        {
          "$ref": "#/$defs/unattested_partial"
        },
        {
          "type": "null"
        }
      ],
      "description": "Non-awarding partial worker observation retained for failed supervision."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "forward",
            "description": "Mandatory processing or failure stage."
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "enum": [
              "train",
              "eval"
            ],
            "description": "Best-effort mode."
          },
          "invocation": {
            "properties": {
              "mode": {
                "enum": [
                  "train",
                  "eval"
                ],
                "description": "Best-effort mode."
              }
            },
            "description": "Best-effort invocation."
          },
          "worker_receipt": {
            "properties": {
              "mode": {
                "enum": [
                  "train",
                  "eval"
                ],
                "description": "Best-effort mode."
              }
            },
            "description": "Best-effort worker receipt."
          }
        }
      },
      "else": {
        "properties": {
          "mode": {
            "type": "null",
            "description": "Best-effort mode."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "failed",
            "description": "Mandatory immutable attempt outcome."
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error",
            "description": "Best-effort error."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "succeeded",
            "description": "Select attempts eligible for a run award."
          }
        }
      },
      "then": {
        "properties": {
          "raw_award_receipt": {
            "$ref": "#/$defs/raw_award_receipt",
            "description": "Successful attempts retain the exact closed raw award receipt."
          },
          "raw_award_receipt_sha256": {
            "$ref": "#/$defs/hash",
            "description": "Successful attempts retain the worker self-hash."
          },
          "unattested_partial": {
            "type": "null",
            "description": "A successful attempt cannot also be an unattested partial."
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "$ref": "attempt-common.schema.json#/$defs/hash"
    },
    "nullable_hash": {
      "$ref": "attempt-common.schema.json#/$defs/nullable_hash"
    },
    "timestamp": {
      "$ref": "attempt-common.schema.json#/$defs/timestamp"
    },
    "nonempty_string": {
      "$ref": "attempt-common.schema.json#/$defs/nonempty_string"
    },
    "nullable_string": {
      "$ref": "attempt-common.schema.json#/$defs/nullable_string"
    },
    "redacted_text": {
      "$ref": "attempt-common.schema.json#/$defs/redacted_text"
    },
    "string_array": {
      "$ref": "attempt-common.schema.json#/$defs/string_array"
    },
    "stage": {
      "$ref": "attempt-common.schema.json#/$defs/stage"
    },
    "reason_code": {
      "$ref": "attempt-common.schema.json#/$defs/reason_code"
    },
    "rung": {
      "$ref": "attempt-common.schema.json#/$defs/rung"
    },
    "retries": {
      "$ref": "attempt-common.schema.json#/$defs/retries"
    },
    "identities": {
      "$ref": "attempt-common.schema.json#/$defs/identities"
    },
    "environment": {
      "oneOf": [
        {
          "$ref": "#/$defs/observed_environment"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "target",
        "env_id",
        "lock_sha256",
        "resolved_export_sha256",
        "python",
        "packages_manifest_sha256",
        "compiler_identity",
        "sdk_identity",
        "authority_epoch",
        "base_environment_generation",
        "environment_content_sha256",
        "environment_authority_id",
        "selected_interpreter_relative_path",
        "selected_interpreter_digest",
        "external_escape_records"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory family."
        },
        "target": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory target."
        },
        "env_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory env id."
        },
        "lock_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory lock sha256."
        },
        "resolved_export_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory resolved export sha256."
        },
        "python": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory python."
        },
        "packages_manifest_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Mandatory packages manifest sha256."
        },
        "compiler_identity": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory compiler identity."
        },
        "sdk_identity": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Mandatory sdk identity."
        },
        "authority_epoch": {
          "$ref": "#/$defs/nullable_string",
          "description": "Live environment-authority discriminator; null for audit-only legacy attempts."
        },
        "base_environment_generation": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Exact pre-seal lifecycle generation."
        },
        "environment_content_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Complete content-manifest digest promoted into the live generation."
        },
        "environment_authority_id": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Local prefix-scoped environment authority identity."
        },
        "selected_interpreter_relative_path": {
          "$ref": "#/$defs/nullable_string",
          "description": "Selected interpreter lexical path relative to the sealed prefix."
        },
        "selected_interpreter_digest": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Exact selected interpreter target digest."
        },
        "external_escape_records": {
          "type": "array",
          "description": "Exact regular-file targets reached by sealed-prefix symlink escapes.",
          "items": {
            "type": "object",
            "description": "One external regular-file escape target bound by path and digest.",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "kind"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/nonempty_string",
                "description": "Canonical absolute external target path."
              },
              "sha256": {
                "$ref": "#/$defs/hash",
                "description": "Exact external target content digest."
              },
              "kind": {
                "const": "regular-file",
                "description": "Closed external target kind."
              }
            }
          }
        }
      }
    },
    "host": {
      "$ref": "attempt-common.schema.json#/$defs/host"
    },
    "invocation": {
      "$ref": "attempt-common.schema.json#/$defs/invocation"
    },
    "input_kind": {
      "$ref": "attempt-common.schema.json#/$defs/input_kind"
    },
    "worker_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "receipt_sha256",
        "observed_recipe_revision",
        "observed_adapter_sha256",
        "observed_code_manifest_sha256",
        "observed_input_asset_sha256",
        "constructor_started",
        "constructor_completed",
        "input_completed",
        "forward_started",
        "forward_completed",
        "mode",
        "input_signature",
        "output_signature",
        "output_value_sha256",
        "input_kind",
        "input_asset",
        "input_note",
        "parameter_count_total",
        "parameter_count_trainable",
        "native_framework",
        "delegated_method"
      ],
      "properties": {
        "present": {
          "type": "boolean",
          "description": "Mandatory present."
        },
        "receipt_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Mandatory receipt sha256."
        },
        "observed_recipe_revision": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Worker-observed recipe revision, required for parent comparison."
        },
        "observed_adapter_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Worker-observed typed-adapter digest, or null for declarative recipes."
        },
        "observed_code_manifest_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Worker-observed digest over the recursive code_manifest bytes, or null when the recipe has no code manifest."
        },
        "observed_input_asset_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Worker-observed digest of the materialized standard input asset, or null when no standard asset was selected."
        },
        "constructor_seconds": {
          "type": [
            "number",
            "null"
          ],
          "description": "Worker-observed model-construction wall seconds, or null when the constructor did not complete."
        },
        "forward_seconds": {
          "type": [
            "number",
            "null"
          ],
          "description": "Worker-observed forward wall seconds for this mode, or null when the forward did not run."
        },
        "constructor_started": {
          "type": "boolean",
          "description": "Mandatory constructor started."
        },
        "constructor_completed": {
          "type": "boolean",
          "description": "Mandatory constructor completed."
        },
        "input_completed": {
          "type": "boolean",
          "description": "Mandatory input completed."
        },
        "forward_started": {
          "type": "boolean",
          "description": "Mandatory forward started."
        },
        "forward_completed": {
          "type": "boolean",
          "description": "Mandatory forward completed."
        },
        "mode": {
          "oneOf": [
            {
              "enum": [
                "train",
                "eval"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory mode."
        },
        "input_signature": {
          "description": "Mandatory input signature."
        },
        "output_signature": {
          "description": "Mandatory output signature."
        },
        "output_value_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Canonical worker-observed output-value digest when representable."
        },
        "input_kind": {
          "oneOf": [
            {
              "$ref": "#/$defs/input_kind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory input kind."
        },
        "input_asset": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory input asset."
        },
        "input_note": {
          "type": "string",
          "description": "Mandatory input note."
        },
        "parameter_count_total": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory parameter count total."
        },
        "parameter_count_trainable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory parameter count trainable."
        },
        "native_framework": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory native framework."
        },
        "delegated_method": {
          "$ref": "#/$defs/nullable_string",
          "description": "Mandatory delegated method."
        }
      }
    },
    "supervisor_observation": {
      "$ref": "attempt-common.schema.json#/$defs/supervisor_observation"
    },
    "policy_observation": {
      "$ref": "attempt-common.schema.json#/$defs/policy_observation"
    },
    "error": {
      "$ref": "attempt-common.schema.json#/$defs/error"
    },
    "defer_evidence": {
      "$ref": "attempt-common.schema.json#/$defs/defer_evidence"
    },
    "raw_award_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_version",
        "request_nonce",
        "request_sha256",
        "stable_id",
        "work_id",
        "execution_identity",
        "recipe_revision",
        "code_manifest_identity",
        "input_identity",
        "requested_mode",
        "observation"
      ],
      "properties": {
        "receipt_version": {
          "const": "menagerie.crawler.raw-award-receipt.v3",
          "description": "Closed worker receipt protocol discriminator."
        },
        "request_nonce": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Fresh parent-issued request nonce echoed by the worker."
        },
        "request_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the exact worker request bytes."
        },
        "stable_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Trusted stable model identity bound into the request."
        },
        "work_id": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Deterministic work identity bound into the request."
        },
        "execution_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact execution dependency identity."
        },
        "recipe_revision": {
          "$ref": "#/$defs/hash",
          "description": "Exact accepted recipe revision."
        },
        "code_manifest_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact accepted implementation closure identity."
        },
        "input_identity": {
          "$ref": "#/$defs/hash",
          "description": "Exact selected input-contract identity."
        },
        "requested_mode": {
          "enum": [
            "train",
            "eval"
          ],
          "description": "Exact requested meaningful runtime mode."
        },
        "observation": {
          "$ref": "#/$defs/worker_receipt",
          "description": "Closed worker-internal constructor, input, forward, signature, and policy observations."
        }
      }
    },
    "capability_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "supported"
      ],
      "properties": {
        "claim": {
          "enum": [
            "needs-cuda",
            "needs-x86"
          ],
          "description": "Exact focused platform claim."
        },
        "supported": {
          "type": "boolean",
          "description": "Parent-observed support result."
        }
      }
    },
    "parent_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_version",
        "request_nonce",
        "request_sha256",
        "completion_line_sha256",
        "named_raw_award_receipt_sha256",
        "exit_code",
        "signal",
        "timed_out",
        "rss_exceeded",
        "peak_rss_bytes",
        "stdout_sha256",
        "stderr_sha256",
        "started_at",
        "finished_at",
        "attestation_sha256"
      ],
      "properties": {
        "attestation_version": {
          "const": "menagerie.crawler.parent-attestation.v2",
          "description": "Closed supervisor attestation protocol discriminator."
        },
        "request_nonce": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Fresh request nonce observed by the parent."
        },
        "request_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the exact request launched by the parent."
        },
        "completion_line_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Digest of the exact worker completion line when present."
        },
        "named_raw_award_receipt_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Raw receipt digest literally named by the completion line."
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parent-observed process exit code."
        },
        "signal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Parent-observed terminating signal."
        },
        "timed_out": {
          "type": "boolean",
          "description": "Whether the parent enforced the timeout."
        },
        "rss_exceeded": {
          "type": "boolean",
          "description": "Whether the parent enforced the RSS limit."
        },
        "peak_rss_bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Best parent-observed peak resident memory."
        },
        "stdout_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Digest of captured standard output bytes."
        },
        "stderr_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Digest of captured standard error bytes."
        },
        "started_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Parent-observed launch timestamp."
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Parent-observed completion timestamp."
        },
        "attestation_sha256": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the canonical parent attestation bytes."
        }
      }
    },
    "unattested_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "stage",
        "reason_code",
        "diagnostic_sha256"
      ],
      "properties": {
        "state": {
          "const": "unattested-partial",
          "description": "Non-awarding partial-observation discriminator."
        },
        "stage": {
          "$ref": "#/$defs/stage",
          "description": "Stage reached before supervision was lost."
        },
        "reason_code": {
          "$ref": "#/$defs/reason_code",
          "description": "Typed reason for retaining only partial evidence."
        },
        "diagnostic_sha256": {
          "$ref": "#/$defs/nullable_hash",
          "description": "Optional digest of redacted diagnostic sidecar bytes."
        }
